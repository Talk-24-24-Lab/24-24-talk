# 24/24 ONE WORLD — exemple de variables (AUCUNE valeur secrète ici, et il ne doit jamais y en avoir).
#
# Le site est statique (HTML/CSS/JS sans compilation) : il ne lit PAS ce fichier.
# Sa configuration publique est dans everywhere/config.js (adresse du projet Supabase + clé PUBLIQUE « publishable »,
# protégée par les règles RLS de la base). La clé service_role ne doit JAMAIS être mise dans le site, ni ici, ni dans Git.

# --- Serveur de TEST (valeurs publiques, déjà visibles dans everywhere/config.js) ---
SUPABASE_URL=https://tbynnefrrxzxufcptijc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Tests automatiques (Playwright + Chromium) ---
# Dossier où écrire les résultats JSON et les captures d'écran.
EW_OUT=./resultats-tests
# Chemin vers axe-core (accessibilité WCAG). Sans lui, les tests d'accessibilité sont marqués en échec.
AXE=./node_modules/axe-core/axe.min.js

# --- À NE JAMAIS REMPLIR DANS UN FICHIER DU DÉPÔT ---
# SUPABASE_SERVICE_ROLE_KEY=   (clé secrète : uniquement dans le tableau de bord Supabase, jamais côté site)
