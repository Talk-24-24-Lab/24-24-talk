        { "type": "choice", "kind": "expression", "expr": "Is it far?", "prompt": "Que veut dire cette question ?", "answer": "C'est loin ?", "options": ["C'est loin ?", "C'est cher ?", "C'est ouvert ?"] },
        { "type": "choice", "prompt": "« The station is near. » La gare est…", "say": "The station is near.", "answer": "près", "options": ["près", "loin", "fermée"] }
      ]
    },
    {
