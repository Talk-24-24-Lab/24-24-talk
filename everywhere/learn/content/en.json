        { "type": "match", "prompt": "Associez chaque mot à sa traduction.", "pairs": [["water", "l'eau"], ["bread", "le pain"], ["coffee", "le café"], ["delicious", "délicieux"]] },
        { "type": "listen", "prompt": "Écoutez, puis choisissez ce que vous entendez.", "say": "How much is it?", "answer": "How much is it?", "options": ["How much is it?", "How are you?", "Where is it?"] },
        { "type": "choice", "kind": "expression", "expr": "A table for two, please.", "prompt": "Que demandez-vous ?", "answer": "Une table pour deux", "options": ["Une table pour deux", "Deux cafés", "L'addition"] },
        { "type": "choice", "prompt": "Vous ne mangez pas de viande. Que dites-vous ?", "answer": "I'm vegetarian.", "options": ["I'm vegetarian.", "I'm hungry.", "It's delicious."] }
      ]
    },
