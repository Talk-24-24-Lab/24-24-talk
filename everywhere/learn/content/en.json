        { "type": "match", "prompt": "Associez chaque mot à sa traduction.", "pairs": [["a meeting", "une réunion"], ["a colleague", "un(e) collègue"], ["available", "disponible"], ["to reply", "répondre"]] },
        { "type": "listen", "prompt": "Écoutez, puis choisissez ce que vous entendez.", "say": "Are you available tomorrow?", "answer": "Are you available tomorrow?", "options": ["Are you available tomorrow?", "Are you at work today?", "Is the meeting tomorrow?"] },
        { "type": "choice", "kind": "expression", "expr": "Let's schedule a meeting.", "prompt": "Que propose votre collègue ?", "answer": "D'organiser une réunion", "options": ["D'organiser une réunion", "D'annuler la réunion", "De déjeuner ensemble"] },
        { "type": "complete", "prompt": "Complétez la phrase.", "sentence": "The ___ is on Friday.", "hint": "La date limite est vendredi.", "answer": "deadline", "options": ["deadline", "colleague", "available"] }
      ]
    },
    {
