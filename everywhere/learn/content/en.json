        { "type": "choice", "kind": "expression", "expr": "See you later!", "prompt": "Que veut dire cette expression ?", "answer": "À plus tard !", "options": ["À plus tard !", "Bon appétit !", "Je suis en retard !"] },
        { "type": "choice", "prompt": "Quelqu'un vous dit « How are you? ». Que répondez-vous ?", "say": "How are you?", "answer": "I'm fine, thank you.", "options": ["I'm fine, thank you.", "My name is Anna.", "Goodbye!"] }
      ]
    },
    {
      "id": "en-deb-2", "level": "debutant", "theme": "Au restaurant", "icon": "☕",
