      "phrases": [
        { "w": "This exam was a piece of cake.", "t": "Cet examen était un jeu d'enfant." },
        { "w": "That car costs an arm and a leg.", "t": "Cette voiture coûte les yeux de la tête." }
      ],
      "exercises": [
        { "type": "choice", "kind": "expression", "expr": "It's raining cats and dogs.", "prompt": "Que veut dire cette expression ?", "answer": "Il pleut des cordes.", "options": ["Il pleut des cordes.", "Il y a beaucoup d'animaux.", "Il fait beau."] },
        { "type": "choice", "kind": "expression", "expr": "Break a leg!", "prompt": "Quand dit-on cela ?", "answer": "Pour souhaiter bonne chance", "options": ["Pour souhaiter bonne chance", "Après un accident", "Pour dire de se dépêcher"] },
        { "type": "match", "prompt": "Associez chaque expression à son sens.", "pairs": [["a piece of cake", "un jeu d'enfant"], ["once in a blue moon", "tous les trente-six du mois"], ["to hit the nail on the head", "mettre le doigt dessus"]] },
        { "type": "complete", "prompt": "Complétez l'expression.", "sentence": "That car costs an arm and a ___.", "hint": "Cette voiture coûte les yeux de la tête.", "answer": "leg", "options": ["leg", "head", "hand"] },
        { "type": "listen", "prompt": "Écoutez, puis choisissez ce que vous entendez.", "say": "Once in a blue moon", "answer": "Once in a blue moon", "options": ["Once in a blue moon", "Once upon a time", "Over the moon"] },
        { "type": "choice", "prompt": "Votre amie résume parfaitement le problème. Vous dites :", "answer": "You hit the nail on the head.", "options": ["You hit the nail on the head.", "It's a piece of cake.", "Break a leg!"] }
      ]
