{"lang":"ga","lot":2,"out":[{"pack":"humor","key":"break_ice","register":"neutral","fr":"Pour briser la glace, je vous offre un café ?","text":"Chun an leac oighir a bhriseadh, an dtabharfainn caife daoibh?","back":"Pour briser la glace, puis-je vous offrir un café ?","err":null,"moteur":"mymemory"},{"pack":"humor","key":"just_kidding","register":"informal","fr":"Je plaisante, bien sûr !","text":"Ag magadh atá mé, ar ndóigh!","back":"Je plaisante, bien sûr !","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"ironic","fr":"Génial, on est lundi…","text":"Go hiontach, is é an Luan é…","back":"Super, c'est lundi…","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"neutral_meaning","fr":"Je n'aime pas les lundis.","text":"Ní maith liom an Luan.","back":"Je n'aime pas le lundi.","err":null,"moteur":"mymemory"}]}