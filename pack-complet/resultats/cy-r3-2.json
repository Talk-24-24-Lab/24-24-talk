{"lang":"cy","lot":2,"out":[{"pack":"humor","key":"break_ice","register":"neutral","fr":"Pour briser la glace, je vous offre un café ?","text":"I dorri'r garw, ga i gynnig paned o goffi i chi?","back":"Pour faire court, puis-je vous proposer une tasse de café ?","err":null,"moteur":"mymemory"},{"pack":"humor","key":"just_kidding","register":"informal","fr":"Je plaisante, bien sûr !","text":"Dim ond jocian, wrth gwrs!","back":"C'est juste une blague, bien sûr !","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"ironic","fr":"Génial, on est lundi…","text":"Gwych, mae'n ddydd Llun…","back":"Super, c'est lundi…","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"neutral_meaning","fr":"Je n'aime pas les lundis.","text":"Dydw i ddim yn hoffi dydd Llun.","back":"Je n'aime pas le lundi.","err":null,"moteur":"mymemory"}]}