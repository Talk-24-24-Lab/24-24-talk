{"lang":"ti","lot":2,"out":[{"pack":"humor","key":"break_ice","register":"neutral","fr":"Pour briser la glace, je vous offre un café ?","text":"ዘረባ ንምጅማር፡ ቡን ክዕድመኩም ዶ?","back":"Pour commencer la conversation, puis-je vous offrir un café ?","err":null,"moteur":"mymemory"},{"pack":"humor","key":"just_kidding","register":"informal","fr":"Je plaisante, bien sûr !","text":"ዋዛ እየ፡ ብርግጽ!","back":"Je plaisante, bien sûr !","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"ironic","fr":"Génial, on est lundi…","text":"ጽቡቕ፡ ሰኑይ እዩ…","back":"C'est bien, c'est lundi…","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"neutral_meaning","fr":"Je n'aime pas les lundis.","text":"ሰኑይ ኣይፈቱን እየ።","back":"Je n'aime pas le lundi.","err":null,"moteur":"mymemory"}]}