{"lang":"ky","lot":2,"out":[{"pack":"humor","key":"break_ice","register":"neutral","fr":"Pour briser la glace, je vous offre un café ?","text":"Сүйлөшүүнү баштоо үчүн, сизге кофе алып берейинби?","back":"Pour commencer la conversation, puis-je vous offrir un café ?","err":null,"moteur":"mymemory"},{"pack":"humor","key":"just_kidding","register":"informal","fr":"Je plaisante, bien sûr !","text":"Албетте, мен тамашаладым!","back":"Bien sûr, je plaisantais !","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"ironic","fr":"Génial, on est lundi…","text":"Сонун, бүгүн дүйшөмбү…","back":"Super, c'est lundi aujourd'hui…","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"neutral_meaning","fr":"Je n'aime pas les lundis.","text":"Мен дүйшөмбүнү жактырбайм.","back":"Je n'aime pas le lundi.","err":null,"moteur":"mymemory"}]}