{"lang":"mg","lot":2,"out":[{"pack":"humor","key":"break_ice","register":"neutral","fr":"Pour briser la glace, je vous offre un café ?","text":"Mba hanombohana ny resaka, afaka manolotra kafe anareo ve aho?","back":"Pour commencer la conversation, puis-je vous offrir un café ?","err":null,"moteur":"mymemory"},{"pack":"humor","key":"just_kidding","register":"informal","fr":"Je plaisante, bien sûr !","text":"Manao vazivazy aho, mazava ho azy!","back":"Je plaisante, bien sûr !","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"ironic","fr":"Génial, on est lundi…","text":"Tsara be, Alatsinainy androany…","back":"C'est bien, aujourd'hui c'est lundi…","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"neutral_meaning","fr":"Je n'aime pas les lundis.","text":"Tsy tiako ny Alatsinainy.","back":"Je n'aime pas le lundi.","err":null,"moteur":"mymemory"}]}