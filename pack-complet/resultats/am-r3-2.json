{"lang":"am","lot":2,"out":[{"pack":"humor","key":"break_ice","register":"neutral","fr":"Pour briser la glace, je vous offre un café ?","text":"በረዶውን ለመስበር፣ ቡና ልጋብዝዎት?","back":"Pour briser la glace, puis-je vous inviter à prendre un café ?","err":null,"moteur":"mymemory"},{"pack":"humor","key":"just_kidding","register":"informal","fr":"Je plaisante, bien sûr !","text":"እየቀለድኩ ነው፣ እርግጥ ነው!","back":"Je plaisante, bien sûr !","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"ironic","fr":"Génial, on est lundi…","text":"በጣም ጥሩ፣ ዛሬ ሰኞ ነው…","back":"Très bien, nous sommes lundi aujourd'hui…","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"neutral_meaning","fr":"Je n'aime pas les lundis.","text":"ሰኞን አልወድም።","back":"Je n'aime pas le lundi.","err":null,"moteur":"mymemory"}]}