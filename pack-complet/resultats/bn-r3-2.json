{"lang":"bn","lot":2,"out":[{"pack":"humor","key":"break_ice","register":"neutral","fr":"Pour briser la glace, je vous offre un café ?","text":"আলাপ শুরু করতে, আমি কি আপনাকে এক কাপ কফি খাওয়াতে পারি?","back":"Pour entamer la conversation, puis-je vous offrir une tasse de café ?","err":null,"moteur":"mymemory"},{"pack":"humor","key":"just_kidding","register":"informal","fr":"Je plaisante, bien sûr !","text":"অবশ্যই, আমি মজা করছি!","back":"Bien sûr, je plaisante !","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"ironic","fr":"Génial, on est lundi…","text":"দারুণ, আজ সোমবার…","back":"Super, aujourd'hui c'est lundi…","err":null,"moteur":"mymemory"},{"pack":"humor","key":"monday_irony","register":"neutral_meaning","fr":"Je n'aime pas les lundis.","text":"আমি সোমবার পছন্দ করি না।","back":"Je n'aime pas les lundis.","err":null,"moteur":"mymemory"}]}