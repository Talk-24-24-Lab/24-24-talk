[{"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "சரக்கு சேதமடைந்து வந்தது."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "அன்பான வாழ்த்துக்களுடன்."}, {"pack": "hotel", "key": "ac_broken", "register": "formal", "fr": "La climatisation ne marche pas.", "text": "குளிரூட்டி இயங்கவில்லை."}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "இது அதிகபட்சம் ஒரு மணி நேரத்தில் பழுது பார்க்கப்படும்."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "நீ இங்கே நன்றாக தங்கினாயா?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "இதை வீடியோ கான்ஃபரன்ஸில் செய்யலாம்."}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "உனக்கு சரியாக என்ன தேவை?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "நீ விலையில் கொஞ்சம் தள்ளுபடி தர முடியுமா?"}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "நான் உனக்கு ஒரு யூனிட்டுக்கு 9 யூரோ முன்மொழிகிறேன்."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ஒப்பந்தம் முடிவானது!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "சரி, ஒப்புக்கொள்கிறேன்!"}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "இந்த ஒப்பந்த ஷரத்தை மாற்ற விரும்புகிறோம்."}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "முன்பதிவு யார் பெயரில் இருக்கிறது?"}, {"pack": "hotel", "key": "checkout_time", "register": "formal", "fr": "Le départ se fait avant 11 heures.", "text": "வெளியேறும் நேரம் 11 மணிக்கு முன்."}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "உனக்கு எந்த நேரத்தில் அறையை சுத்தம் செய்ய வேண்டும்?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "நான் இப்போது அறையை சுத்தம் செய்யலாமா?"}]