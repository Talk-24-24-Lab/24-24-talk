[{"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "మా పత్రాలు నీ దగ్గర వదిలి వెళ్తాను."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "నేను నీకు ఒక్కో యూనిట్‌కు 9 యూరోలు ప్రతిపాదిస్తున్నాను."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "బేరం కుదిరింది!"}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "నేను డబ్బు ఎక్కడ విత్‌డ్రా చేయవచ్చు?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "మనం దీన్ని వీడియో కాన్ఫరెన్స్‌లో చేయవచ్చు."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "మనం దీన్ని రేపటికి వాయిదా వేయగలమా?"}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "మీ అవసరం ఖచ్చితంగా ఏమిటి?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "నీ అవసరం సరిగ్గా ఏమిటి?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "బుకింగ్ ఎవరి పేరు మీద ఉంది?"}, {"pack": "hotel", "key": "checkout_time", "register": "formal", "fr": "Le départ se fait avant 11 heures.", "text": "చెక్-అవుట్ 11 గంటలకు ముందు."}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "నీకు శుభ్రపరచడం ఏ సమయానికి కావాలి?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "నేను ఇప్పుడు శుభ్రం చేయవచ్చా?"}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "హాయిగా భోజనం చేయండి!"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "ఇది గరిష్ఠంగా ఒక గంటలో రిపేర్ అవుతుంది."}]