[{"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "Narx bo'yicha chegirma qila olasizmi?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Narx bo'yicha chegirma qila olasanmi?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Bitim tuzildi!"}, {"pack": "business", "key": "best_regards", "register": "informal", "fr": "À bientôt !", "text": "Tez orada ko'rishguncha!"}, {"pack": "hotel", "key": "non_smoking", "register": "formal", "fr": "Toutes les chambres sont non-fumeurs.", "text": "Barcha xonalar chekmaydiganlar uchun."}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "Tozalashni soat nechada xohlaysan?"}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "Buni xonang hisobiga qo'shaymi?"}, {"pack": "hotel", "key": "how_far", "register": "formal", "fr": "C'est loin à pied ?", "text": "Piyoda uzoqmi?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Qolishing yaxshi o'tdimi?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Buni videokonferensiya orqali qilsak bo'ladi."}, {"pack": "business", "key": "start_meeting", "register": "formal", "fr": "Commençons, si vous le voulez bien.", "text": "Agar xohlasangiz, boshlaylik."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Ertaga qoldirsak bo'ladimi?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Bu kimning nomiga?"}, {"pack": "hotel", "key": "checkout_time", "register": "formal", "fr": "Le départ se fait avant 11 heures.", "text": "Chiqish soat 11 dan oldin."}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "Xonaga ertaroq kira olamanmi?"}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Kvitansiya kerakmi?"}]