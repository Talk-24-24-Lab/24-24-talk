[{"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "ഒരു യൂണിറ്റിന് 9 യൂറോ ഞാൻ നിനക്ക് നിർദ്ദേശിക്കുന്നു."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "കച്ചവടം ഉറപ്പിച്ചു!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "ശരി, സമ്മതം!"}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "ഈ കരാർ വ്യവസ്ഥ മാറ്റാൻ ഞങ്ങൾ ആഗ്രഹിക്കുന്നു."}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "നിനക്ക് നിന്റെ കോഡ് ടൈപ്പ് ചെയ്യാം."}, {"pack": "hotel", "key": "price_night", "register": "formal", "fr": "Combien coûte une nuit ?", "text": "ഒരു രാത്രിക്ക് എത്ര വിലയാണ്?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "formal", "fr": "À quelle heure voulez-vous qu'on fasse le ménage ?", "text": "ഏത് സമയത്ത് മുറി വൃത്തിയാക്കണമെന്നാണ് താങ്കൾ ആഗ്രഹിക്കുന്നത്?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "നിനക്ക് ഏത് സമയത്ത് മുറി വൃത്തിയാക്കണം?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "ഞാൻ പിന്നീട് വീണ്ടും വരാം."}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "ഇത് നിന്റെ മുറിയിൽ ചേർക്കട്ടെ?"}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "ഭക്ഷണം ആസ്വദിക്കൂ!"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "ഏറ്റവും വൈകിയാൽ ഒരു മണിക്കൂറിനുള്ളിൽ ഇത് നന്നാക്കും."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "നിങ്ങളുടെ താമസം നല്ലതായിരുന്നോ?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "നിന്റെ താമസം നല്ലതായിരുന്നോ?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "വീഡിയോ കോളിൽ നമുക്ക് ഇത് ചെയ്യാൻ പറ്റും."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "നമുക്ക് നാളത്തേക്ക് മാറ്റാമോ?"}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "നിങ്ങളുടെ ആവശ്യം കൃത്യമായി എന്താണ്?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "നിനക്ക് കൃത്യമായി എന്താണ് ആവശ്യം?"}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "ഞങ്ങളുടെ ഡോക്യുമെന്റ് ഞാൻ നിനക്ക് തന്നിട്ട് പോകാം."}]