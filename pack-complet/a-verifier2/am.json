[{"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "ስለ ቅናሻችን እንደገና እያገኘሁህ ነው።"}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "የመጨረሻው ቀነ-ገደብ ዓርብ ነው።"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "አሁን ክፍሉን ማጽዳት እችላለሁ?"}, {"pack": "hotel", "key": "invoice_email", "register": "formal", "fr": "Voulez-vous la facture par e-mail ?", "text": "የሂሳብ መጠየቂያውን በኢሜይል ይፈልጋሉ?"}, {"pack": "hotel", "key": "invoice_email", "register": "informal", "fr": "Tu veux la facture par e-mail ?", "text": "የሂሳብ መጠየቂያውን በኢሜይል ትፈልጋለህ?"}, {"pack": "business", "key": "nice_to_meet", "register": "formal", "fr": "Enchanté de vous rencontrer.", "text": "እርስዎን በማግኘቴ ደስ ብሎኛል።"}, {"pack": "business", "key": "nice_to_meet", "register": "informal", "fr": "Ravi de te rencontrer.", "text": "አንተን በማግኘቴ ደስ ብሎኛል።"}, {"pack": "hotel", "key": "change_room", "register": "formal", "fr": "Est-ce que je peux changer de chambre ?", "text": "የመኝታ ክፍል መቀየር እችላለሁ?"}, {"pack": "hotel", "key": "iron", "register": "formal", "fr": "Est-ce que je peux avoir un fer à repasser ?", "text": "የልብስ መተኮሻ ካውያ ማግኘት እችላለሁ?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "ክፍሉ በስንት ሰዓት እንዲጸዳ ትፈልጋለህ?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "ይህን በቪዲዮ ጥሪ ልናደርገው እንችላለን።"}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "ፍላጎትዎ በትክክል ምንድን ነው?"}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "ሰነዳችንን ልተውልህ።"}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "ለአንዱ 9 ዩሮ አቀርብልሃለሁ።"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ስምምነቱ ተጠናቋል!"}]