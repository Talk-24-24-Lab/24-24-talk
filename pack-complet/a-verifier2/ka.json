[{"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "ეს ვისი სახელზეა?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "შემიძლია ახლა ოთახი დავასუფთავო?"}, {"pack": "hotel", "key": "call_doctor", "register": "informal", "fr": "J'appelle un médecin pour toi.", "text": "ექიმს დაგიძახებ."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "თქვენი ყოფნა კარგი იყო?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "შენი ყოფნა კარგი იყო?"}, {"pack": "business", "key": "thank_time", "register": "informal", "fr": "Merci pour ton temps.", "text": "მადლობა შენი დროისთვის."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "ამის გაკეთება ვიდეოზარით შეგვიძლია."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "შეგვიძლია ხვალისთვის გადავდოთ?"}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "შემიძლია დემო გაჩვენო."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "გარიგება დადებულია!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "კარგი, თანახმა ვარ!"}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "ჩვენი შეთავაზების თაობაზე გიბრუნდებით."}, {"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "ჩვენი შეთავაზების თაობაზე გიბრუნდები."}]