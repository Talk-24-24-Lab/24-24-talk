[{"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Amasezerano yemejwe!"}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "Twifuza guhindura iyi ngingo y'amasezerano."}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "Ibicuruzwa byageze byangiritse."}, {"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "Ngarutse kuri wowe ku byerekeye icyifuzo cyacu."}, {"pack": "business", "key": "satisfied", "register": "informal", "fr": "Tu es content de notre service ?", "text": "Ese wishimiye serivisi zacu?"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Mu cyubahiro."}, {"pack": "business", "key": "urgent", "register": "informal", "fr": "C'est urgent, peux-tu t'en occuper aujourd'hui ?", "text": "Birihutirwa, ushobora kubikora uyu munsi?"}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "Ni byiza, akazi keza cyane!"}, {"pack": "business", "key": "share_file", "register": "informal", "fr": "Je te partage le fichier.", "text": "Ndagusangiza iyi dosiye."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Dushobora kubikorera kuri videwo."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "Ni iki mukeneye neza?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "Ukeneye iki neza neza?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Nshobora kubereka uko bikora."}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "Ndabagezaho amayero 9 kuri buri kimwe."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "Ndakugezaho amayero 9 kuri buri kimwe."}, {"pack": "hotel", "key": "allergy", "register": "formal", "fr": "Avez-vous une allergie alimentaire ?", "text": "Mufite aleriji ku biryo?"}, {"pack": "hotel", "key": "allergy", "register": "informal", "fr": "Tu as une allergie alimentaire ?", "text": "Ufite aleriji ku biryo?"}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Mugire ifunguro ryiza!"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "Bizaba byakozwe mu isaha imwe, ntibirenze."}, {"pack": "hotel", "key": "airport_transfer", "register": "formal", "fr": "Nous proposons une navette pour l'aéroport. Il faut réserver la veille.", "text": "Dufite imodoka ijya ku kibuga cy'indege. Mugomba kuyitumiza umunsi ubanziriza."}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "Ni hehe nshobora kubikuza amafaranga?"}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Niba wishimye, ushobora gutanga igitekerezo cyawe kuri interineti."}, {"pack": "hotel", "key": "have_booking", "register": "formal", "fr": "Avez-vous une réservation ?", "text": "Mwabikishije icyumba?"}, {"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "Icyumba cyabikishijwe mu izina rya nde?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Ni mu izina rya nde?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Muri abantu bangahe?"}, {"pack": "hotel", "key": "how_many_people", "register": "informal", "fr": "Vous êtes combien ?", "text": "Muri abantu bangahe se?"}, {"pack": "hotel", "key": "booked_online", "register": "formal", "fr": "J'ai réservé sur internet.", "text": "Nabikishije icyumba kuri interineti."}, {"pack": "hotel", "key": "receipt", "register": "formal", "fr": "Voulez-vous un reçu ?", "text": "Murifuza inyemezabwishyu?"}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Urashaka inyemezabwishyu?"}, {"pack": "hotel", "key": "safe", "register": "formal", "fr": "Il y a un coffre-fort dans le placard.", "text": "Hari isanduku y'umutekano mu kabati."}, {"pack": "hotel", "key": "extra_pillow", "register": "formal", "fr": "Pourriez-vous m'apporter un oreiller supplémentaire ?", "text": "Mwanzanira undi musego wo kuryamaho?"}, {"pack": "hotel", "key": "towels", "register": "formal", "fr": "Est-ce que je peux avoir des serviettes propres ?", "text": "Nshobora kubona ibitambaro byo kwihanagura bisukuye?"}, {"pack": "hotel", "key": "buffet", "register": "formal", "fr": "C'est un buffet : servez-vous.", "text": "Ni ifunguro rya bifeti: mwiyarurire."}]