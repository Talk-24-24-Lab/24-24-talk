[{"pack": "hotel", "key": "iron", "register": "formal", "fr": "Est-ce que je peux avoir un fer à repasser ?", "text": "Naweza kupata pasi ya kunyoosha nguo?"}, {"pack": "hotel", "key": "bus_stop", "register": "formal", "fr": "L'arrêt de bus est juste devant l'hôtel.", "text": "Kituo cha basi kiko mbele tu ya hoteli."}, {"pack": "hotel", "key": "broken_report", "register": "informal", "fr": "La douche de la 305 fuit, il faut prévenir le technicien.", "text": "Bafu ya kuoga ya 305 inavuja, inabidi kumjulisha fundi."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Tunaweza kufanya hivi kwa simu ya video."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "Nakupendekezea euro 9 kwa kila kimoja."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Mpango umekamilika!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Sawa, tumekubaliana!"}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "Bidhaa zimefika zikiwa zimeharibika."}, {"pack": "business", "key": "share_file", "register": "informal", "fr": "Je te partage le fichier.", "text": "Nakushirikisha faili."}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Ni kwa jina gani?"}]