[{"pack": "business", "key": "my_role", "register": "formal", "fr": "Je suis responsable des ventes.", "text": "Ndi uwujejwe ivy'ukudandaza."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Dushobora kubikora biciye kuri videwo."}, {"pack": "business", "key": "agenda", "register": "formal", "fr": "Voici l'ordre du jour de la réunion.", "text": "Iyi ni urutonde rw'ivyo inama izokwigako."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "Ivyo mukeneye neza neza ni ibiki?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "Ivyo ukeneye neza neza ni ibiki?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Ndashobora kubagirira akarorero."}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "Ndashobora kukugirira akarorero."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Ushaka gutumiza ibingahe?"}, {"pack": "business", "key": "minimum_order", "register": "formal", "fr": "La commande minimum est de 500 pièces.", "text": "Ugutumiza kwa make ni ibice 500."}, {"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "Mushobora kugabanya gato igiciro?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Ushobora kugabanya gato igiciro?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "Ndabashikiriza amayero 9 ku gice kimwe."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "Ndagushikiriza amayero 9 ku gice kimwe."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Amasezerano yaremejwe!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Ni vyiza, ndemeye!"}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "Twipfuza guhindura iyi ngingo y'amasezerano."}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "Ibidandazwa vyashitse vyangiritse."}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "Ndagarutse kuri mwebwe ku vyerekeye ivyo twabashikirije."}, {"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "Ndagarutse kuri wewe ku vyerekeye ivyo twagushikirije."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Mbaramukije n'umutima mwiza."}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "Ni vyiza, akazi keza!"}, {"pack": "business", "key": "share_file", "register": "informal", "fr": "Je te partage le fichier.", "text": "Ndagusangiza idosiye."}, {"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "Ukubika kwanditswe mw'izina rya nde?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Ukubika ni mw'izina rya nde?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Muri abantu bangahe?"}, {"pack": "hotel", "key": "receipt", "register": "formal", "fr": "Voulez-vous un reçu ?", "text": "Mwipfuza agapapuro k'ukwishyura?"}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Wipfuza agapapuro k'ukwishyura?"}, {"pack": "hotel", "key": "buffet", "register": "informal", "fr": "C'est un buffet : sers-toi.", "text": "Ni bife: ifatire ibifungurwa."}, {"pack": "hotel", "key": "allergy", "register": "informal", "fr": "Tu as une allergie alimentaire ?", "text": "Ufise aleriji y'ibifungurwa?"}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Muryoherwe n'ibifungurwa!"}, {"pack": "hotel", "key": "sorry_problem", "register": "formal", "fr": "Je suis vraiment désolé pour ce problème.", "text": "Ndasaba imbabazi cane kubera iki kibazo."}, {"pack": "hotel", "key": "airport_transfer", "register": "formal", "fr": "Nous proposons une navette pour l'aéroport. Il faut réserver la veille.", "text": "Turatanga imodoka ija ku kibuga c'indege. Mutegerezwa kuyisaba ku musi ubanziriza."}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "Ni hehe noshobora kubikuza amafaranga?"}, {"pack": "hotel", "key": "fire_exit", "register": "formal", "fr": "La sortie de secours est au bout du couloir.", "text": "Aho gusohokera mu gihe c'ingorane hari ku mpera ya koridore."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "Ukuba kwanyu hano kwagenze neza?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Ukuba kwawe hano kwagenze neza?"}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Nimba unezerewe, ushobora gusiga iciyumviro kuri interineti."}, {"pack": "business", "key": "nice_to_meet", "register": "formal", "fr": "Enchanté de vous rencontrer.", "text": "Nezerewe no guhura namwe."}, {"pack": "business", "key": "nice_to_meet", "register": "informal", "fr": "Ravi de te rencontrer.", "text": "Nezerewe no guhura nawe."}]