[{"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "ಇದು ಹೆಚ್ಚೆಂದರೆ ಒಂದು ಗಂಟೆಯಲ್ಲಿ ಸರಿಯಾಗುತ್ತದೆ."}, {"pack": "hotel", "key": "late_checkout", "register": "formal", "fr": "Est-ce que je peux partir plus tard ?", "text": "ನಾನು ತಡವಾಗಿ ಹೊರಡಬಹುದೇ?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "ನಿನ್ನ ತಂಗುವಿಕೆ ಚೆನ್ನಾಗಿತ್ತಾ?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "ನಾವು ಇದನ್ನು ವಿಡಿಯೋ ಕಾನ್ಫರೆನ್ಸ್‌ನಲ್ಲಿ ಮಾಡಬಹುದು."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "ನಿಮ್ಮ ಅಗತ್ಯ ನಿಖರವಾಗಿ ಏನು?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "ನಿನಗೆ ನಿಖರವಾಗಿ ಏನು ಅಗತ್ಯವಿದೆ?"}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "ನಾನು ನಮ್ಮ ದಾಖಲೆಗಳನ್ನು ನಿಮಗೆ ಬಿಟ್ಟು ಹೋಗುತ್ತೇನೆ."}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "ಹಾಯ್, ಸ್ವಾಗತ! ನಿನಗೆ ಏನಾದರೂ ಸಹಾಯ ಮಾಡಲೇ?"}, {"pack": "hotel", "key": "fill_form", "register": "informal", "fr": "Tu peux remplir et signer cette fiche ?", "text": "ಈ ಫಾರ್ಮ್ ಭರ್ತಿ ಮಾಡಿ ಸಹಿ ಹಾಕುತ್ತೀಯಾ?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "ನೀವು ಎಷ್ಟು ಜನ ಇದ್ದೀರಿ?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "ನಿನ್ನ ರಹಸ್ಯ ಸಂಖ್ಯೆಯನ್ನು ಒತ್ತಬಹುದು."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "ರಸೀದಿ ಬೇಕಾ?"}, {"pack": "hotel", "key": "iron", "register": "formal", "fr": "Est-ce que je peux avoir un fer à repasser ?", "text": "ನನಗೆ ಇಸ್ತ್ರಿ ಪೆಟ್ಟಿಗೆ ಸಿಗಬಹುದೇ?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "ನಾನು ಈಗ ಕೋಣೆ ಸ್ವಚ್ಛಗೊಳಿಸಬಹುದೇ?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "ನಾನು ನಂತರ ಮತ್ತೆ ಬರುತ್ತೇನೆ."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "ನಾನು ನಿನಗೆ ಒಂದಕ್ಕೆ 9 ಯೂರೋ ಪ್ರಸ್ತಾಪಿಸುತ್ತೇನೆ."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ಒಪ್ಪಂದ ಅಂತಿಮವಾಯಿತು!"}]