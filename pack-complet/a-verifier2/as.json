[{"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "এইটো কাৰ নামত?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "আপোনালোক কেইজন মানুহ?"}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "তোমাক ৰচিদ লাগে নেকি?"}, {"pack": "hotel", "key": "balcony", "register": "formal", "fr": "La chambre a un balcon.", "text": "কোঠাটোৰ এটা বেলকনি আছে।"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "মই এতিয়া কোঠাটো চাফা কৰিব পাৰোঁনে?"}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "আপোনাৰ সঠিক প্ৰয়োজনটো কি?"}, {"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "আপুনি দামটো অলপ কমাব পাৰিবনে?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "তুমি দামটো অলপ কমাব পাৰিবানে?"}, {"pack": "business", "key": "ask_manager", "register": "formal", "fr": "Je dois en parler à ma direction.", "text": "মই এই বিষয়ে মোৰ পৰিচালনাৰ সৈতে কথা পাতিব লাগিব।"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "চুক্তি সম্পন্ন হ'ল!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "ঠিক আছে, সন্মত!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "শুভেচ্ছাসহ।"}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "বাহ, ভাল কাম!"}, {"pack": "hotel", "key": "taxi", "register": "informal", "fr": "Tu veux que j'appelle un taxi ?", "text": "তোমাৰ বাবে এখন টেক্সী মাতিম নেকি?"}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "মই ক'ৰ পৰা টকা উলিয়াব পাৰিম?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "আমি এইটো ভিডিঅ' কলত কৰিব পাৰোঁ।"}]