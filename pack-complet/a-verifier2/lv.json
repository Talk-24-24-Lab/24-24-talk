[{"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "Prece ieradās bojāta."}, {"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "Es atgriežos pie tevis saistībā ar mūsu piedāvājumu."}, {"pack": "business", "key": "looking_forward", "register": "formal", "fr": "Au plaisir de travailler avec vous.", "text": "Priecāsimies strādāt ar jums."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Ar sirsnīgu cieņu."}, {"pack": "business", "key": "share_file", "register": "informal", "fr": "Je te partage le fichier.", "text": "Es ar tevi kopīgoju failu."}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "Pierakstīt to uz tavu istabu?"}, {"pack": "business", "key": "available_tuesday", "register": "formal", "fr": "Êtes-vous disponible mardi à 10 heures ?", "text": "Vai jūs būtu pieejams otrdien plkst. 10?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Varam to izdarīt pa video."}, {"pack": "business", "key": "agenda", "register": "formal", "fr": "Voici l'ordre du jour de la réunion.", "text": "Šeit ir sanāksmes darba kārtība."}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Uz kura vārda?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Es varu jums parādīt demonstrāciju."}, {"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "Vai jūs varētu nedaudz samazināt cenu?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Vari nedaudz nolaist cenu?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Darījums noslēgts!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Labi, esam vienojušies!"}]