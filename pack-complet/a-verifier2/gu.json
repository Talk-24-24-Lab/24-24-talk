[{"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "તને અહીં રહેવાની મજા આવી?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "આપણે આ વીડિયો કોન્ફરન્સમાં કરી શકીએ."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "આપની જરૂરિયાત બરાબર શું છે?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "તારી જરૂરિયાત બરાબર શું છે?"}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "હું આપને અમારા દસ્તાવેજો આપી જાઉં છું."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "હું તને અમારા દસ્તાવેજો આપી જાઉં છું."}, {"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "શું આપ કિંમત પર થોડી છૂટ આપી શકો?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "શું તું કિંમત પર થોડી છૂટ આપી શકે?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "સોદો નક્કી થયો!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "બરાબર, આપણે સહમત છીએ!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "હાર્દિક શુભેચ્છાઓ સાથે."}, {"pack": "hotel", "key": "fill_form", "register": "informal", "fr": "Tu peux remplir et signer cette fiche ?", "text": "શું તું આ ફોર્મ ભરીને તેના પર સહી કરી શકે?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "શું હું હમણાં સફાઈ કરી શકું?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text":