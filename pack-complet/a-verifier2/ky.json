[{"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Бүтүм түзүлдү!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Макул, келиштик!"}, {"pack": "business", "key": "contract_length", "register": "formal", "fr": "Le contrat dure un an, renouvelable.", "text": "Келишим бир жылга созулат жана узартылат."}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "Бул жобону өзгөрткүбүз келет."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Урматтоо менен."}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "Бөлмөнү азыр тазаласам болобу?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Мейманканада жакшы болдуңбу?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Кимдин атына?"}, {"pack": "hotel", "key": "receipt", "register": "formal", "fr": "Voulez-vous un reçu ?", "text": "Квитанция каалайсызбы?"}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Квитанция каалайсыңбы?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Муну видео аркылуу кылсак болот."}, {"pack": "business", "key": "start_meeting", "register": "formal", "fr": "Commençons, si vous le voulez bien.", "text": "Каалсаңыз, баштайлы."}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Сизге демонстрация жасап бере алам."}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "Сага демонстрация жасап берейин."}, {"pack": "business", "key": "can_do_better", "register": "informal", "f