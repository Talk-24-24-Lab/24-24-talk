[{"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ਸੌਦਾ ਹੋ ਗਿਆ!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "ਠੀਕ ਹੈ, ਸਹਿਮਤ ਹਾਂ!"}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "ਮੈਂ ਸਾਡੇ ਪ੍ਰਸਤਾਵ ਬਾਰੇ ਤੁਹਾਡੇ ਕੋਲ ਵਾਪਸ ਆ ਰਿਹਾ ਹਾਂ।"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "ਸਤਿਕਾਰ ਸਹਿਤ।"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "ਮੈਂ ਤੈਨੂੰ ਜਲਦੀ ਨਾਲ ਸਾਡੀ ਕੰਪਨੀ ਬਾਰੇ ਦੱਸਦਾ ਹਾਂ।"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "ਅਸੀਂ ਇਹ ਵੀਡੀਓ ਤੇ ਕਰ ਸਕਦੇ ਹਾਂ।"}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "ਕੀ ਅਸੀਂ ਇਸਨੂੰ ਕੱਲ੍ਹ ਤੱਕ ਅੱਗੇ ਕਰ ਸਕਦੇ ਹਾਂ?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "ਤੂੰ ਕੀਮਤ ਥੋੜ੍ਹੀ ਘੱਟ ਕਰ ਸਕਦਾ ਹੈਂ?"}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "ਖਾਣਾ ਸੁਆਦ ਨਾਲ ਖਾਓ!"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "ਇਹ ਵੱਧ ਤੋਂ ਵੱਧ ਇੱਕ ਘੰਟੇ ਵਿੱਚ ਠੀਕ ਕਰ ਦਿੱਤਾ ਜਾਵੇਗਾ।"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "ਕੀ ਤੁਹਾਡਾ ਠਹਿਰਾਅ ਚੰਗਾ ਰਿਹਾ?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "ਤੇਰਾ ਠਹਿਰਾਅ ਚੰਗਾ ਰਿਹਾ?"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "ਹੈਲੋ, ਜੀ ਆਇਆਂ ਨੂੰ! ਕੀ ਮੈਂ ਤੇਰੀ ਮਦਦ ਕਰ ਸਕਦਾ ਹਾਂ?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "ਇਹ ਕਿਸ ਦੇ ਨਾਂ ਤੇ ਹੈ?"}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "ਤੈਨੂੰ ਰਸੀਦ ਚਾਹੀਦੀ ਹੈ?"}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "ਇਹ ਤੇਰੇ ਕਮਰੇ ਤੇ ਪਾ ਦਿਆਂ?"}]