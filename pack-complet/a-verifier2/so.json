xt": "Waa cunto buufee ah: fadlan iska qaata."}, {"pack": "hotel", "key": "manager", "register": "formal", "fr": "Je voudrais parler au responsable.", "text": "Waxaan rabaa inaan la hadlo masuulka."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "Joogitaankiinnu ma wanaagsanaa?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Joogitaankaagu ma wanaagsanaa?"}, {"pack": "hotel", "key": "guest_waiting", "register": "informal", "fr": "Un client attend à l'accueil.", "text": "Macmiil ayaa ku sugaya qaabilaadda."}]