[{"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Na leen neex!"}, {"pack": "hotel", "key": "compensation", "register": "informal", "fr": "Pour nous excuser, ton petit-déjeuner est offert.", "text": "Ngir nu jéggalu la, sa lekku suba bi, ñu ngi la ko may."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "Lan mooy seen soxla bu leer?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "Lan nga soxla, bu leer?"}, {"pack": "business", "key": "urgent", "register": "informal", "fr": "C'est urgent, peux-tu t'en occuper aujourd'hui ?", "text": "Dafa jamp, ndax mën nga ko toppatoo tey?"}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Baaxul, ngir tàmbali…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Lii baaxagul dara."}]