[{"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Ena loloma kei na veidokai."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "E rawarawa vakalevu!"}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Me da vakacegu, au rawa ni solia vei kemuni e dua na kofi?"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Totoka, nikua na Moniti…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Au sega sara ni taleitaka na Moniti."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "E veivakadredretaki sara!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Kemuni kua ni cudru, e veiwali ga."}]