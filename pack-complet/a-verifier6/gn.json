[{"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Reñembohoryhína chehegui!"}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Ñapytu'u hag̃ua, ikatúpa ame'ẽ peẽme peteĩ kafe?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Broma rei, katuete!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Iporã, ko'ãga ha'e lunes…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Ndachegustái umi lunes."}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Ani pende pochy, broma rei kuri."}, {"pack": "hotel", "key": "baby_cot", "register": "formal", "fr": "Un lit bébé est disponible gratuitement.", "text": "Mitã'i rupa oĩ ojeporu hag̃ua reiete."}]