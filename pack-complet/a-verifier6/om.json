[{"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Baay'ee gaarii, har'a Isniina…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Guyyaa Isniinaa hin jaalladhu."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Baay'ee kolfisiisaa ture!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Hin aarinaa, qoosaa qofa ture."}, {"pack": "business", "key": "sign_here", "register": "informal", "fr": "Tu peux signer ici ?", "text": "Mallattoo harkaa asitti kaa'uu dandeessaa?"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Nagaa fi kabajaa wajjin."}]