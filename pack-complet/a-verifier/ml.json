[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "നിന്നെ വീണ്ടും കണ്ടതിൽ സന്തോഷം!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "ഹായ്, സ്വാഗതം! ഞാൻ നിന്നെ സഹായിക്കട്ടെ?"}, {"pack": "hotel", "key": "fill_form", "register": "informal", "fr": "Tu peux remplir et signer cette fiche ?", "text": "ഈ ഫോം പൂരിപ്പിച്ച് ഒപ്പിടാമോ?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "നിങ്ങൾ എത്ര പേരുണ്ട്?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "നിന്റെ രഹസ്യ നമ്പർ അടിക്കാം."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "രസീത് വേണോ?"}, {"pack": "hotel", "key": "price_night", "register": "formal", "fr": "Combien coûte une nuit ?", "text": "ഒരു രാത്രിക്ക് എത്രയാണ് നിരക്ക്?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "formal", "fr": "À quelle heure voulez-vous qu'on fasse le ménage ?", "text": "മുറി എപ്പോൾ വൃത്തിയാക്കണമെന്നാണ് താങ്കൾ ആഗ്രഹിക്കുന്നത്?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "മുറി എപ്പോൾ വൃത്തിയാക്കണം?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "ഞാൻ ഇപ്പോൾ മുറി വൃത്തിയാക്കിക്കോട്ടെ?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "ഇപ്പോൾ മുറി വൃത്തിയാക്കട്ടെ?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "ഞാൻ പിന്നീട് വരാം."}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "ഇത് നിന്റെ മുറിയുടെ ബില്ലിൽ ചേർക്കട്ടെ?"}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "അടുത്തുള്ള ഒരു നല്ല ഹോട്ടൽ നിനക്ക് പറഞ്ഞുതരാം."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "നല്ല ഭക്ഷണം ആസ്വദിക്കൂ!"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "പരമാവധി ഒരു മണിക്കൂറിനുള്ളിൽ ഇത് ശരിയാക്കും."}, {"pack": "hotel", "key": "taxi", "register": "formal", "fr": "Voulez-vous que j'appelle un taxi ?", "text": "ഞാൻ നിങ്ങൾക്ക് ഒരു ടാക്സി വിളിക്കട്ടെ?"}, {"pack": "hotel", "key": "taxi", "register": "informal", "fr": "Tu veux que j'appelle un taxi ?", "text": "നിനക്ക് ടാക്സി വിളിക്കട്ടെ?"}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "ഇതാ നിന്റെ ബിൽ."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "നിങ്ങളുടെ താമസം സുഖകരമായിരുന്നോ?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "താമസം നന്നായിരുന്നോ?"}, {"pack": "business", "key": "nice_to_meet", "register": "informal", "fr": "Ravi de te rencontrer.", "text": "നിന്നെ പരിചയപ്പെട്ടതിൽ സന്തോഷം!"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "ഞങ്ങളുടെ കമ്പനിയെക്കുറിച്ച് ചുരുക്കി പറയാം."}, {"pack": "business", "key": "thank_time", "register": "informal", "fr": "Merci pour ton temps.", "text": "സമയം തന്നതിന് നന്ദി."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "നമുക്ക് ഇത് വീഡിയോ കോളിൽ ചെയ്യാം."}, {"pack": "business", "key": "start_meeting", "register": "formal", "fr": "Commençons, si vous le voulez bien.", "text": "നിങ്ങൾക്ക് സമ്മതമാണെങ്കിൽ, നമുക്ക് തുടങ്ങാം."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "നാളത്തേക്ക് മാറ്റാമോ?"}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "നിങ്ങൾക്ക് കൃത്യമായി എന്താണ് വേണ്ടത്?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "നിനക്ക് കൃത്യമായി എന്താണ് വേണ്ടത്?"}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "ഞങ്ങളുടെ ബ്രോഷർ ഞാൻ നിനക്ക് തരാം."}, {"pack": "business", "key": "customized", "register": "informal", "fr": "On peut adapter l'offre à ta boîte.", "text": "നിന്റെ കമ്പനിക്ക് അനുസരിച്ച് ഓഫർ മാറ്റിത്തരാം."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "നിനക്ക് എത്ര എണ്ണം ഓർഡർ ചെയ്യണം?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "ഒന്നിന് 9 യൂറോ എന്ന് ഞാൻ നിർദ്ദേശിക്കുന്നു."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "ഒന്നിന് 9 യൂറോ തരാം, എന്ത് പറയുന്നു?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ഇടപാട് ഉറപ്പിച്ചു!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "ശരി, സമ്മതിച്ചു!"}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "ഈ വ്യവസ്ഥ മാറ്റാൻ ഞങ്ങൾ ആഗ്രഹിക്കുന്നു."}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "ഏത് കറൻസിയിൽ പണം നൽകണം?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "നിന്റെ ഓർഡർ അയച്ചുകഴിഞ്ഞു."}, {"pack": "business", "key": "looking_forward", "register": "informal", "fr": "Au plaisir de bosser avec toi.", "text": "നിന്നോടൊപ്പം ജോലി ചെയ്യാൻ കാത്തിരിക്കുന്നു!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "ആശംസകളോടെ."}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "അടിപൊളി, നല്ല ജോലി!"}]