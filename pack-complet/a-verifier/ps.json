[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "بیا دې په لیدو خوشحاله شوم!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "سلام، ښه راغلې! مرسته درسره وکړم؟"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "تاسو څو کسان یاست؟"}, {"pack": "hotel", "key": "how_many_people", "register": "informal", "fr": "Vous êtes combien ?", "text": "تاسو څو تنه یئ؟"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "خپل کوډ ولیکه."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "رسید غواړې؟"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "ایا اوس کوټه پاکولی شم؟"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "اوس کوټه پاکه کړم؟"}, {"pack": "hotel", "key": "vegetarian", "register": "formal", "fr": "Nous avons des plats végétariens.", "text": "موږ سبزیجاتي خواړه لرو."}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "دلته نږدې یو ښه رستورانت درښودلی شم."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "نوش جان!"}, {"pack": "hotel", "key": "compensation", "register": "formal", "fr": "Pour nous excuser, le petit-déjeuner vous est offert.", "text": "د بخښنې په توګه، ستاسو ناشته وړیا ده."}, {"pack": "hotel", "key": "late_checkout", "register": "formal", "fr": "Est-ce que je peux partir plus tard ?", "text": "ایا وروسته وتلی شم؟"}, {"pack": "hotel", "key": "here_invoice", "register": "formal", "fr": "Voici votre facture.", "text": "دا ستاسو بل دی."}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "دا دې بل دی."}, {"pack": "hotel", "key": "invoice_email", "register": "formal", "fr": "Voulez-vous la facture par e-mail ?", "text": "ایا بل په بریښنالیک کې غواړئ؟"}, {"pack": "hotel", "key": "invoice_email", "register": "informal", "fr": "Tu veux la facture par e-mail ?", "text": "بل په بریښنالیک کې غواړې؟"}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "که خوښ وې، په انټرنېټ کې خپل نظر پرېښودلی شې."}, {"pack": "hotel", "key": "colleague_help", "register": "informal", "fr": "Tu peux m'aider à la réception ?", "text": "په استقبالیه کې راسره مرسته کولی شې؟"}, {"pack": "hotel", "key": "broken_report", "register": "informal", "fr": "La douche de la 305 fuit, il faut prévenir le technicien.", "text": "د 305 شاور څاڅي، تخنیکار ته باید خبر ورکړو."}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "ژر به دې زموږ شرکت درمعرفي کړم."}, {"pack": "business", "key": "available_tuesday", "register": "formal", "fr": "Êtes-vous disponible mardi à 10 heures ?", "text": "ایا تاسو د سه شنبې په ورځ 10 بجې وزګار یاست؟"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "دا کار په ویډیو کولی شو."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "سبا ته یې وځنډوو؟"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "ته دقیقاً څه ته اړتیا لرې؟"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "زه تاسو ته عملي ښودنه کولی شم."}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "زه درته ښودلی شم چې څنګه کار کوي."}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "خپل معلوماتي اسناد تاسو ته پرېږدم."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "خپل کاغذونه درته پرېږدم."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "څومره غواړې چې فرمایش ورکړې؟"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "معامله وشوه!"}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "موږ غواړو دا ماده بدله کړو."}, {"pack": "business", "key": "send_invoice", "register": "informal", "fr": "Je t'envoie la facture aujourd'hui.", "text": "بل به نن درولېږم."}, {"pack": "business", "key": "invoice_late", "register": "formal", "fr": "Cette facture n'est pas encore payée.", "text": "دا بل لا تر اوسه نه دی ورکړل شوی."}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "په کومو اسعارو پیسې ورکول غواړې؟"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "ستا فرمایش ولېږل شو."}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "توکي خراب رسیدلي دي."}, {"pack": "business", "key": "looking_forward", "register": "informal", "fr": "Au plaisir de bosser avec toi.", "text": "له تا سره د کار کولو په هیله یم."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "په درناوي."}, {"pack": "business", "key": "best_regards", "register": "informal", "fr": "À bientôt !", "text": "بیا به سره ووینو!"}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "وروستۍ نېټه جمعه ده."}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "شاباس، ښه کار دې کړی!"}]