[{"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "გამარჯობა, კეთილი იყოს შენი მობრძანება! რით შემიძლია დაგეხმარო?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "ვისი სახელით არის?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "რამდენი ადამიანი ბრძანდებით?"}, {"pack": "hotel", "key": "breakfast_hours", "register": "formal", "fr": "Le petit-déjeuner est servi de 7 heures à 10 heures 30.", "text": "საუზმე მიირთმევა 7 საათიდან 10:30-მდე."}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "შეიძლება ოთახში უფრო ადრე შევიდე?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "შეგიძლია შენი საიდუმლო კოდი აკრიფო."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "ქვითარი გინდა?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "ახლა დავალაგო ოთახი?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "მოგვიანებით შემოვივლი."}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "შენი ოთახის ანგარიშზე ჩავწერო?"}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "შემიძლია ახლოს კარგი რესტორანი გირჩიო."}, {"pack": "hotel", "key": "manager", "register": "formal", "fr": "Je voudrais parler au responsable.", "text": "მსურს მენეჯერთან საუბარი."}, {"pack": "hotel", "key": "call_doctor", "register": "informal", "fr": "J'appelle un médecin pour toi.", "text": "ახლავე ექიმს დაგიძახებ."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "კარგად დაისვენეთ ჩვენთან?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "კარგად დაისვენე?"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "მოკლედ გაგაცნობ ჩვენს კომპანიას."}, {"pack": "business", "key": "thank_time", "register": "informal", "fr": "Merci pour ton temps.", "text": "მადლობა, რომ დრო გამოყავი."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "შეგვიძლია ვიდეოზარით გავაკეთოთ."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "ხვალისთვის გადავდოთ?"}, {"pack": "business", "key": "summary_email", "register": "informal", "fr": "Je t'envoie un résumé par e-mail.", "text": "შეჯამებას ელფოსტით გამოგიგზავნი."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "ზუსტად რა გჭირდებათ?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "ზუსტად რა გჭირდება?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "შემიძლია დემონსტრაცია ჩაგიტაროთ."}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "შემიძლია გაჩვენო, როგორ მუშაობს."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "ჩვენს საინფორმაციო მასალას დაგიტოვებ."}, {"pack": "business", "key": "customized", "register": "informal", "fr": "On peut adapter l'offre à ta boîte.", "text": "შეგვიძლია შეთავაზება შენს კომპანიას მოვარგოთ."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "შევთანხმდით!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "კარგი, შევთანხმდით!"}, {"pack": "business", "key": "e_signature", "register": "formal", "fr": "Vous pouvez signer en ligne, c'est valable légalement.", "text": "შეგიძლიათ ონლაინ მოაწეროთ ხელი, ეს კანონიერად ძალაშია."}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "რომელი ვალუტით გინდა გადახდა?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "შენი შეკვეთა გაიგზავნა."}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "გიკავშირდებით ჩვენი შეთავაზების თაობაზე."}, {"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "გიკავშირდები ჩვენი შეთავაზების თაობაზე."}, {"pack": "business", "key": "satisfied", "register": "informal", "fr": "Tu es content de notre service ?", "text": "კმაყოფილი ხარ ჩვენი მომსახურებით?"}, {"pack": "business", "key": "looking_forward", "register": "informal", "fr": "Au plaisir de bosser avec toi.", "text": "მოუთმენლად ველი შენთან თანამშრომლობას!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "პატივისცემით."}]