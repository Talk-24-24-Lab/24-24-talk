[{"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "Haia, croeso! Alla i dy helpu di?"}, {"pack": "hotel", "key": "have_booking", "register": "formal", "fr": "Avez-vous une réservation ?", "text": "Oes gennych chi archeb?"}, {"pack": "hotel", "key": "have_booking", "register": "informal", "fr": "Tu as une réservation ?", "text": "Oes gen ti archeb?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Faint ohonoch chi sydd?"}, {"pack": "hotel", "key": "breakfast_hours", "register": "formal", "fr": "Le petit-déjeuner est servi de 7 heures à 10 heures 30.", "text": "Mae brecwast yn cael ei weini o 7 o'r gloch tan 10.30."}, {"pack": "hotel", "key": "booked_online", "register": "formal", "fr": "J'ai réservé sur internet.", "text": "Fe wnes i archebu ar-lein."}, {"pack": "hotel", "key": "housekeeping_time", "register": "formal", "fr": "À quelle heure voulez-vous qu'on fasse le ménage ?", "text": "Am faint o'r gloch hoffech chi i ni lanhau'r ystafell?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "Am faint o'r gloch wyt ti eisiau i ni lanhau'r ystafell?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "Ga i lanhau'r ystafell nawr?"}, {"pack": "hotel", "key": "buffet", "register": "informal", "fr": "C'est un buffet : sers-toi.", "text": "Bwffe yw e: helpa dy hun."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Mwynhewch eich bwyd!"}, {"pack": "hotel", "key": "manager", "register": "formal", "fr": "Je voudrais parler au responsable.", "text": "Hoffwn i siarad â'r rheolwr."}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "Dyma dy anfoneb."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Gest ti arhosiad braf?"}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Os wyt ti'n hapus, gelli di adael adolygiad ar-lein."}, {"pack": "hotel", "key": "shift_change", "register": "informal", "fr": "Je finis à 18 heures, qui me remplace ?", "text": "Dw i'n gorffen am 18 o'r gloch, pwy sy'n cymryd fy lle?"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "Gad i mi gyflwyno ein cwmni yn gyflym."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Gallwn ni wneud hyn dros alwad fideo."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Allwn ni symud i yfory?"}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Faint wyt ti eisiau ei archebu?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Bargen!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "Ym mha arian wyt ti eisiau talu?"}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "Cyrhaeddodd y nwyddau wedi'u difrodi."}, {"pack": "business", "key": "looking_forward", "register": "informal", "fr": "Au plaisir de bosser avec toi.", "text": "Edrych ymlaen at weithio gyda ti!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Yn gywir."}]