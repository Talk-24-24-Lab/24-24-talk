[{"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "سلام، خوش اومدی! کمکی از دستم برمیاد؟"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "چند نفر هستید؟"}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "می‌توانم زودتر وارد اتاق شوم؟"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "می‌تونی رمزت رو وارد کنی."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "رسید می‌خوای؟"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "اجازه می‌دهید الان اتاق را تمیز کنم؟"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "می‌تونم الان اتاق رو تمیز کنم؟"}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "به حساب اتاقت بنویسم؟"}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "می‌تونم یه رستوران خوب همین نزدیکی بهت معرفی کنم."}, {"pack": "hotel", "key": "late_checkout", "register": "formal", "fr": "Est-ce que je peux partir plus tard ?", "text": "می‌توانم دیرتر اتاق را تحویل بدهم؟"}, {"pack": "business", "key": "nice_to_meet", "register": "informal", "fr": "Ravi de te rencontrer.", "text": "از آشنایی باهات خوشحالم."}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "سریع شرکتمون رو بهت معرفی می‌کنم."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "می‌تونیم با تماس تصویری انجامش بدیم."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "می‌شه بذاریمش برای فردا؟"}, {"pack": "business", "key": "any_questions", "register": "formal", "fr": "Avez-vous des questions ?", "text": "آیا سؤالی دارید؟"}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "می‌تونم یه دمو نشونت بدم."}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "بروشور ما را خدمت شما می‌گذارم."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "بروشورمون رو برات می‌ذارم."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "چندتا می‌خوای سفارش بدی؟"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "معامله انجام شد!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "باشه، قبوله!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "می‌خوای با چه ارزی پرداخت کنی؟"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "سفارشت ارسال شد."}, {"pack": "business", "key": "delay_sorry", "register": "formal", "fr": "Nous sommes désolés pour ce retard de livraison.", "text": "بابت تأخیر در تحویل عذرخواهی می‌کنیم."}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "کالا آسیب‌دیده به دست ما رسیده است."}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "در خصوص پیشنهادمان مجدداً با شما تماس می‌گیرم."}, {"pack": "business", "key": "long_term", "register": "formal", "fr": "Nous voulons construire un partenariat sur le long terme.", "text": "ما می‌خواهیم یک همکاری بلندمدت ایجاد کنیم."}, {"pack": "business",