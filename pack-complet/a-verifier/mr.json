[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "तुला पुन्हा भेटून आनंद झाला!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "नमस्कार, स्वागत आहे! काही मदत हवी आहे का?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "कोणाच्या नावावर आहे?"}, {"pack": "hotel", "key": "fill_form", "register": "informal", "fr": "Tu peux remplir et signer cette fiche ?", "text": "हा फॉर्म भरून सही करशील का?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "आपण किती जण आहात?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "तू तुझा कोड टाकू शकतोस."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "पावती हवी आहे का?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "मी आता खोली स्वच्छ करू शकतो का?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "मी नंतर पुन्हा येईन."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "आपले जेवण चविष्ट होवो!"}, {"pack": "hotel", "key": "taxi", "register": "formal", "fr": "Voulez-vous que j'appelle un taxi ?", "text": "आपल्यासाठी टॅक्सी बोलावू का?"}, {"pack": "hotel", "key": "taxi", "register": "informal", "fr": "Tu veux que j'appelle un taxi ?", "text": "तुझ्यासाठी टॅक्सी बोलावू का?"}, {"pack": "hotel", "key": "how_far", "register": "formal", "fr": "C'est loin à pied ?", "text": "चालत गेल्यास लांब आहे का?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "आपला मुक्काम चांगला झाला का?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé