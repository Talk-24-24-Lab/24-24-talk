[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "Ngiyajabula ukukubona futhi!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "Sawubona, wamukelekile! Ngingakusiza?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Kungaphansi kwegama likabani?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Ningaba bangaki?"}, {"pack": "hotel", "key": "how_many_people", "register": "informal", "fr": "Vous êtes combien ?", "text": "Nibangaki?"}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "Ngingangena ekamelweni ngaphambi kwesikhathi?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "Ungafaka inombolo yakho eyimfihlo."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Ufuna irisidi?"}, {"pack": "hotel", "key": "iron", "register": "formal", "fr": "Est-ce que je peux avoir un fer à repasser ?", "text": "Ngingathola insimbi yokuayina?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "formal", "fr": "À quelle heure voulez-vous qu'on fasse le ménage ?", "text": "Ningathanda ukuthi sihlanze ikamelo ngasiphi isikhathi?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "Ufuna sihlanze ikamelo ngasiphi isikhathi?"}, {"pack": "hotel", "key": "toilet_paper", "register": "formal", "fr": "Il n'y a plus de papier toilette.", "text": "Iphepha lasendlini encane liphelile."}, {"pack": "hotel", "key": "allergy", "register": "informal", "fr": "Tu as une allergie alimentaire ?", "text": "Ingabe kukhona ukudla okungezwani nawe?"}, {"pack": "hotel", "key": "vegetarian", "register": "formal", "fr": "Nous avons des plats végétariens.", "text": "Sinokudla okungenanyama."}, {"pack": "hotel", "key": "charge_room", "register": "formal", "fr": "Je le mets sur votre chambre ?", "text": "Ngingakufaka ezindlekweni zekamelo lenu?"}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "Ngikufake ekamelweni lakho?"}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "Ngingakutshela ngendawo yokudla enhle eseduze."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Ningadla kamnandi!"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "Kuzolungiswa ngaphakathi kwehora elilodwa kuphela."}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "Ngingayikhipha kuphi imali?"}, {"pack": "hotel", "key": "call_doctor", "register": "formal", "fr": "J'appelle un médecin pour vous.", "text": "Ngizonibizela udokotela."}, {"pack": "hotel", "key": "first_aid", "register": "formal", "fr": "Nous avons une trousse de premiers secours à la réception.", "text": "Sinesikhwama sosizo lokuqala emnyango wokwamukela izivakashi."}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Uma wenelisekile, ungabhala umbono wakho ku-inthanethi."}, {"pack": "hotel", "key": "colleague_help", "register": "informal", "fr": "Tu peux m'aider à la réception ?", "text": "Ungangisiza emnyango wokwamukela izivakashi?"}, {"pack": "business", "key": "nice_to_meet", "register": "formal", "fr": "Enchanté de vous rencontrer.", "text": "Ngiyajabula ukunazi."}, {"pack": "business", "key": "nice_to_meet", "register": "informal", "fr": "Ravi de te rencontrer.", "text": "Ngiyajabula ukukwazi!"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "Ake ngikuchazele ngokushesha ngenkampani yethu."}, {"pack": "business", "key": "what_company", "register": "informal", "fr": "Tu travailles dans quelle boîte ?", "text": "Usebenza kuyiphi inkampani?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Singakwenza ngevidiyo."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Singakuhlehlisela kusasa?"}, {"pack": "business", "key": "summary_email", "register": "formal", "fr": "Je vous enverrai un compte rendu par e-mail.", "text": "Ngizonithumelela isifinyezo nge-imeyili."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "Yini ngempela eniyidingayo?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "Udingani ngempela?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Ngingakhombisa ukuthi kusebenza kanjani."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "Ngikushiyela izincwajana zethu."}, {"pack": "business", "key": "customized", "register": "informal", "fr": "On peut adapter l'offre à ta boîte.", "text": "Singakulungisa okunikezwayo kufanele inkampani yakho."}, {"pack": "business", "key": "quote_valid", "register": "formal", "fr": "Ce devis est valable 30 jours.", "text": "Lesi silinganiso sentengo sisebenza izinsuku ezingu-30."}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Ungehlisa intengo kancane?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "Nginihlinzeka ngama-euro angu-9 ngento ngayinye."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Sivumelene!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Kulungile, sivumelene!"}, {"pack": "business", "key": "contract_length", "register": "formal", "fr": "Le contrat dure un an, renouvelable.", "text": "Inkontileka ihlala unyaka owodwa, futhi ingavuselelwa."}, {"pack": "business", "key": "invoice_late", "register": "formal", "fr": "Cette facture n'est pas encore payée.", "text": "Le invoyisi ayikakhokhelwa."}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "Ufuna ukukhokha ngaluphi uhlobo lwemali?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "I-oda lakho selithunyelwe."}, {"pack": "business", "key": "long_term", "register": "formal", "fr": "Nous voulons construire un partenariat sur le long terme.", "text": "Sifuna ukwakha ubudlelwano besikhathi eside."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Ngokuzithoba."}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "Usuku lokugcina nguLwesihlanu."}, {"pack": "business", "key": "share_file", "register": "informal", "fr": "Je te partage le fichier.", "text": "Ngikuthumelela ifayela."}]