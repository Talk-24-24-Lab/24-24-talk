[{"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "Zdravo, dobro došao! Mogu li ti pomoći?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Koliko vas je?"}, {"pack": "hotel", "key": "breakfast_hours", "register": "formal", "fr": "Le petit-déjeuner est servi de 7 heures à 10 heures 30.", "text": "Doručak se služi od 7 do 10:30 sati."}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "Mogu li ući u sobu ranije?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "Možeš ukucati svoj PIN."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Hoćeš račun?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "Mogu li sada očistiti sobu?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "Da ti sad očistim sobu?"}, {"pack": "hotel", "key": "manager", "register": "formal", "fr": "Je voudrais parler au responsable.", "text": "Želio bih razgovarati s menadžerom."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Je li ti bio ugodan boravak?"}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Ako si zadovoljan, možeš ostaviti recenziju na internetu."}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "Ukratko ću ti predstaviti našu firmu."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Možemo to uraditi preko videopoziva."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Možemo li pomjeriti za sutra?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Mogu Vam napraviti demonstraciju."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Koliko želiš naručiti?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Dogovoreno!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Može, dogovorili smo se!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "U kojoj valuti želiš platiti?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "Tvoja narudžba je poslana."}, {"pack": "business", "key": "looking_forward", "register": "formal", "fr": "Au plaisir de travailler avec vous.", "text": "Radujem se saradnji s Vama."}]