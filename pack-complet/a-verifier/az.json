[{"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "Salam, xoş gəldin! Sənə kömək edə bilərəm?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Kimin adınadır?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Neçə nəfərsiniz?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "Kodunu daxil edə bilərsən."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Qəbz istəyirsən?"}, {"pack": "hotel", "key": "price_night", "register": "formal", "fr": "Combien coûte une nuit ?", "text": "Bir gecə neçəyədir?"}, {"pack": "hotel", "key": "baby_cot", "register": "formal", "fr": "Un lit bébé est disponible gratuitement.", "text": "Uşaq çarpayısı pulsuz təqdim olunur."}, {"pack": "hotel", "key": "housekeeping_time", "register": "formal", "fr": "À quelle heure voulez-vous qu'on fasse le ménage ?", "text": "Otağınızın saat neçədə təmizlənməsini istəyirsiniz?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "İndi otağı təmizləyə bilərəmmi?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "Bir az sonra yenidən gələcəyəm."}, {"pack": "hotel", "key": "room_service", "register": "formal", "fr": "Le service en chambre est disponible jusqu'à 22 heures.", "text": "Otağa xidmət saat 22:00-a qədər mövcuddur."}, {"pack": "hotel", "key": "how_far", "register": "formal", "fr": "C'est loin à pied ?", "text": "Piyada uzaqdır?"}, {"pack": "hotel", "key": "late_checkout_fee", "register": "formal", "fr": "Le départ tardif jusqu'à 14 heures coûte 30 euros.", "text": "Saat 14:00-a qədər gec çıxış 30 avro təşkil edir."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "Burada qalmağınız xoş keçdimi?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Burada qalmağın xoş keçdi?"}, {"pack": "hotel", "key": "vip_arrival", "register": "informal", "fr": "Un client important arrive à 15 heures.", "text": "Saat 15:00-da vacib bir qonaq gəlir."}, {"pack": "hotel", "key": "shift_change", "register": "informal", "fr": "Je finis à 18 heures, qui me remplace ?", "text": "Saat 18:00-da işim bitir, məni kim əvəz edəcək?"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "Sənə qısaca şirkətimizi təqdim edim."}, {"pack": "business", "key": "thank_time", "register": "informal", "fr": "Merci pour ton temps.", "text": "Vaxt ayırdığın üçün sağ ol."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Bunu video zənglə edə bilərik."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Sabaha keçirə bilərikmi?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Sizə nümayiş keçirə bilərəm."}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "Bukletimizi Sizə təqdim edirəm."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "Bukletimizi sənə saxlayıram."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Nə qədər sifariş etmək istəyirsən?"}, {"pack": "business", "key": "vat", "register": "formal", "fr": "Les prix sont-ils hors taxes ou toutes taxes comprises ?", "text": "Qiymətlərə vergilər daxildir, yoxsa vergisizdir?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Razılaşdıq!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Oldu, razıyam!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "Hansı valyutada ödəmək istəyirsən?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "Sifarişin yola düşdü."}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "Təklifimizlə bağlı Sizə yenidən müraciət edirəm."}, {"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "Təklifimizlə bağlı sənə yenidən yazıram."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Hörmətlə."}]