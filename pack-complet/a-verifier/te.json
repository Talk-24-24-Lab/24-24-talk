[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "నిన్ను మళ్ళీ చూడటం సంతోషంగా ఉంది!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "హాయ్, స్వాగతం! నీకు ఏమైనా సహాయం చేయనా?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "ఎవరి పేరు మీద ఉంది?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "మీరు ఎంత మంది ఉన్నారు?"}, {"pack": "hotel", "key": "leave_luggage", "register": "informal", "fr": "Tu peux laisser tes bagages ici en attendant.", "text": "వేచి ఉన్నంతసేపు నీ సామాను ఇక్కడ పెట్టవచ్చు."}, {"pack": "hotel", "key": "checkout_time", "register": "formal", "fr": "Le départ se fait avant 11 heures.", "text": "ఉదయం 11 గంటల లోపు గది ఖాళీ చేయాలి."}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "నీ రహస్య సంఖ్యను నొక్కవచ్చు."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "రసీదు కావాలా?"}, {"pack": "hotel", "key": "iron", "register": "formal", "fr": "Est-ce que je peux avoir un fer à repasser ?", "text": "నాకు ఇస్త్రీ పెట్టె దొరుకుతుందా?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "నీ గదిని ఏ సమయానికి శుభ్రం చేయాలి?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "నేను ఇప్పుడు గదిని శుభ్రం చేయవచ్చా?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "ఇప్పుడు గది శుభ్రం చేయనా?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "నేను తర్వాత మళ్ళీ వస్తాను."}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "దీన్ని నీ గది బిల్లులో వేయనా?"}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "దగ్గర్లో ఒక మంచి రెస్టారెంట్ నీకు చెప్పగలను."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "భోజనం ఆస్వాదించండి!"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "గరిష్ఠంగా ఒక గంటలో సరిచేస్తాము."}, {"pack": "hotel", "key": "taxi", "register": "formal", "fr": "Voulez-vous que j'appelle un taxi ?", "text": "మీ కోసం టాక్సీ పిలవమంటారా?"}, {"pack": "hotel", "key": "taxi", "register": "informal", "fr": "Tu veux que j'appelle un taxi ?", "text": "నీ కోసం టాక్సీ పిలవనా?"}, {"pack": "hotel", "key": "how_far", "register": "formal", "fr": "C'est loin à pied ?", "text": "నడిచి వెళ్తే దూరమా?"}, {"pack": "hotel", "key": "map", "register": "formal", "fr": "Voici un plan de la ville.", "text": "ఇదిగో నగర పటం."}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "నేను డబ్బు ఎక్కడ తీసుకోవచ్చు?"}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "ఇదిగో నీ బిల్లు."}, {"pack": "hotel", "key": "keep_luggage_after", "register": "informal", "fr": "On peut garder tes bagages après le départ.", "text": "గది ఖాళీ చేసిన తర్వాత కూడా నీ సామాను మేము ఉంచుకోగలం."}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "మా కంపెనీ గురించి క్లుప్తంగా చెబుతాను."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "ఇది వీడియో కాల్‌లో చేయొచ్చు."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "రేపటికి మార్చగలమా?"}, {"pack": "business", "key": "summary_email", "register": "formal", "fr": "Je vous enverrai un compte rendu par e-mail.", "text": "సమావేశ సారాంశాన్ని మీకు ఈమెయిల్ ద్వారా పంపిస్తాను."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "మీకు ఖచ్చితంగా ఏమి కావాలి?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "నీకు సరిగ్గా ఏం కావాలి?"}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "మా వివరణ పుస్తకం నీకు ఇస్తాను."}, {"pack": "business", "key": "customized", "register": "informal", "fr": "On peut adapter l'offre à ta boîte.", "text": "నీ కంపెనీకి తగ్గట్టుగా ఆఫర్‌ని మార్చగలం."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "నీకు ఎన్ని ఆర్డర్ చేయాలి?"}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "ఒక్కోదానికి 9 యూరోలు ఇస్తాను, సరేనా?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ఒప్పందం కుదిరింది!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "ఏ కరెన్సీలో చెల్లించాలనుకుంటున్నావు?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "నీ ఆర్డర్ పంపించబడింది."}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "సరుకు పాడైన స్థితిలో వచ్చింది."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "శుభాకాంక్షలతో."}]