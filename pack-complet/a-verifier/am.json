[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "እንደገና ስላየሁህ ደስ ብሎኛል!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "ሰላም፣ እንኳን ደህና መጣህ! ልረዳህ እችላለሁ?"}, {"pack": "hotel", "key": "have_booking", "register": "informal", "fr": "Tu as une réservation ?", "text": "ቦታ አስይዘሃል?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "ስንት ሰው ናችሁ?"}, {"pack": "hotel", "key": "leave_luggage", "register": "informal", "fr": "Tu peux laisser tes bagages ici en attendant.", "text": "እስክትጠብቅ ድረስ ሻንጣህን እዚህ መተው ትችላለህ።"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "የሚስጥር ቁጥርህን ማስገባት ትችላለህ።"}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "ደረሰኝ ትፈልጋለህ?"}, {"pack": "hotel", "key": "change_room", "register": "formal", "fr": "Est-ce que je peux changer de chambre ?", "text": "ክፍል መቀየር እችላለሁ?"}, {"pack": "hotel", "key": "iron", "register": "formal", "fr": "Est-ce que je peux avoir un fer à repasser ?", "text": "ካውያ ማግኘት እችላለሁ?"}, {"pack": "hotel", "key": "extra_pillow", "register": "formal", "fr": "Pourriez-vous m'apporter un oreiller supplémentaire ?", "text": "እባክዎ ተጨማሪ ትራስ ሊያመጡልኝ ይችላሉ?"}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "ክፍልህ በስንት ሰዓት እንዲጸዳ ትፈልጋለህ?"}, {"pack": "hotel", "key": "do_not_disturb", "register": "informal", "fr": "Mets le panneau « Ne pas déranger » si tu veux être tranquille.", "text": "እረፍት ከፈለግህ «አትረብሹ» የሚለውን ምልክት አንጠልጥል።"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "አሁን ክፍሉን ላጽዳው?"}, {"pack": "hotel", "key": "found_item", "register": "informal", "fr": "On a trouvé ça dans ta chambre.", "text": "ይህንን ክፍልህ ውስጥ አግኝተነዋል።"}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "ቢዘገይ በአንድ ሰዓት ውስጥ ይጠገናል።"}, {"pack": "hotel", "key": "call_doctor", "register": "formal", "fr": "J'appelle un médecin pour vous.", "text": "ሐኪም እጠራልዎታለሁ።"}, {"pack": "hotel", "key": "late_checkout", "register": "formal", "fr": "Est-ce que je peux partir plus tard ?", "text": "ዘግይቼ መውጣት እችላለሁ?"}, {"pack": "hotel", "key": "invoice_email", "register": "formal", "fr": "Voulez-vous la facture par e-mail ?", "text": "ደረሰኙን በኢሜይል ይፈልጋሉ?"}, {"pack": "hotel", "key": "invoice_email", "register": "informal", "fr": "Tu veux la facture par e-mail ?", "text": "ደረሰኙን በኢሜይል ትፈልጋለህ?"}, {"pack": "business", "key": "nice_to_meet", "register": "formal", "fr": "Enchanté de vous rencontrer.", "text": "ስለተዋወቅን ደስ ብሎኛል።"}, {"pack": "business", "key": "nice_to_meet", "register": "informal", "fr": "Ravi de te rencontrer.", "text": "ስላወቅሁህ ደስ ብሎኛል።"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "ድርጅታችንን በአጭሩ ላስተዋውቅህ።"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "በቪዲዮ ልናደርገው እንችላለን።"}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "ወደ ነገ ልናዛውረው እንችላለን?"}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "በትክክል ምን ያስፈልግዎታል?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "በትክክል ምን ያስፈልግሃል?"}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "የእኛን መረጃ ሰነድ ልተውልህ።"}, {"pack": "business", "key": "customized", "register": "informal", "fr": "On peut adapter l'offre à ta boîte.", "text": "አቅርቦቱን ለድርጅትህ ማስማማት እንችላለን።"}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "ስንት ማዘዝ ትፈልጋለህ?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "በአንዱ 9 ዩሮ እንዲሆን አቀርባለሁ።"}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "በአንዱ 9 ዩሮ ልበልህ።"}, {"pack": "business", "key": "need_think", "register": "formal", "fr": "J'ai besoin d'y réfléchir.", "text": "ማሰብ ያስፈልገኛል።"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ተስማምተናል!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "በየትኛው ገንዘብ መክፈል ትፈልጋለህ?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "ትዕዛዝህ ተልኳል።"}, {"pack": "business", "key": "follow_up", "register": "informal", "fr": "Je reviens vers toi pour notre proposition.", "text": "ስለ ሀሳባችን እንደገና ላገኝህ ፈልጌ ነው።"}, {"pack": "business", "key": "long_term", "register": "formal", "fr": "Nous voulons construire un partenariat sur le long terme.", "text": "የረጅም ጊዜ አጋርነት መገንባት እንፈልጋለን።"}, {"pack": "business", "key": "satisfied", "register": "informal", "fr": "Tu es content de notre service ?", "text": "በአገልግሎታችን ረክተሃል?"}, {"pack": "business", "key": "looking_forward", "register": "informal", "fr": "Au plaisir de bosser avec toi.", "text": "አብረን ለመስራት በጉጉት እጠብቃለሁ።"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "ከሰላምታ ጋር።"}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "የመጨረሻው ቀን ዓርብ ነው።"}]