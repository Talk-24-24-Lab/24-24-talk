[{"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "ಹಾಯ್, ಸ್ವಾಗತ! ನಿನಗೆ ಏನಾದರೂ ಸಹಾಯ ಮಾಡಲೇ?"}, {"pack": "hotel", "key": "fill_form", "register": "informal", "fr": "Tu peux remplir et signer cette fiche ?", "text": "ಈ ಫಾರ್ಮ್ ಭರ್ತಿ ಮಾಡಿ ಸಹಿ ಹಾಕುತ್ತೀಯಾ?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "ನೀವು ಎಷ್ಟು ಜನ ಇದ್ದೀರಿ?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "ನಿನ್ನ ರಹಸ್ಯ ಸಂಖ್ಯೆಯನ್ನು ಒತ್ತಬಹುದು."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "ರಸೀದಿ ಬೇಕಾ?"}, {"pack": "hotel", "key": "iron", "register": "formal", "fr": "Est-ce que je peux avoir un fer à repasser ?", "text": "ನನಗೆ ಇಸ್ತ್ರಿ ಪೆಟ್ಟಿಗೆ ಸಿಗಬಹುದೇ?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "ನಾನು ಈಗ ಕೋಣೆ ಸ್ವಚ್ಛಗೊಳಿಸಬಹುದೇ?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "ನಾನು ನಂತರ ಮತ್ತೆ ಬರುತ್ತೇನೆ."}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "ಹತ್ತಿರದಲ್ಲೇ ಒಂದು ಒಳ್ಳೆಯ ರೆಸ್ಟೋರೆಂಟ್ ನಿನಗೆ ಸೂಚಿಸಬಲ್ಲೆ."}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "ಗರಿಷ್ಠ ಒಂದು ಗಂಟೆಯೊಳಗೆ ಸರಿಪಡಿಸಲಾಗುವುದು."}, {"pack": "hotel", "key": "late_checkout", "register": "formal", "fr": "Est-ce que je peux partir plus tard ?", "text": "ನಾನು ತಡವಾಗಿ ಕೋಣೆ ಖಾಲಿ ಮಾಡಬಹುದೇ?"}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "ಇಗೋ ನಿನ್ನ ಬಿಲ್."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "ನಿಮ್ಮ ವಾಸ ಚೆನ್ನಾಗಿತ್ತೇ?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "ನಿನ್ನ ವಾಸ ಚೆನ್ನಾಗಿತ್ತಾ?"}, {"pack": "hotel", "key": "colleague_help", "register": "informal", "fr": "Tu peux m'aider à la réception ?", "text": "ರಿಸೆಪ್ಷನ್‌ನಲ್ಲಿ ನನಗೆ ಸ್ವಲ್ಪ ಸಹಾಯ ಮಾಡುತ್ತೀಯಾ?"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "ನಮ್ಮ ಕಂಪನಿಯ ಬಗ್ಗೆ ಸಂಕ್ಷಿಪ್ತವಾಗಿ ಹೇಳುತ್ತೇನೆ."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "ಇದನ್ನು ವಿಡಿಯೋ ಕಾಲ್‌ನಲ್ಲಿ ಮಾಡಬಹುದು."}, {"pack": "business", "key": "start_meeting", "register": "formal", "fr": "Commençons, si vous le voulez bien.", "text": "ನಿಮಗೆ ಒಪ್ಪಿಗೆಯಾದರೆ, ಪ್ರಾರಂಭಿಸೋಣ."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "ನಿಮಗೆ ನಿಖರವಾಗಿ ಏನು ಬೇಕು?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "ನಿನಗೆ ಸರಿಯಾಗಿ ಏನು ಬೇಕು?"}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "ನಮ್ಮ ಮಾಹಿತಿ ಕೈಪಿಡಿಯನ್ನು ನಿಮಗೆ ಕೊಡುತ್ತೇನೆ."}, {"pack": "business", "key": "customized", "register": "informal", "fr": "On peut adapter l'offre à ta boîte.", "text": "ನಿನ್ನ ಕಂಪನಿಗೆ ತಕ್ಕಂತೆ ಆಫರ್ ಬದಲಾಯಿಸಬಹುದು."}, {"pack": "business", "key": "send_quote", "register": "informal", "fr": "Je t'envoie un devis d'ici demain.", "text": "ನಾಳೆಯೊಳಗೆ ನಿನಗೆ ದರಪಟ್ಟಿ ಕಳುಹಿಸುತ್ತೇನೆ."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "ನಿನಗೆ ಎಷ್ಟು ಆರ್ಡರ್ ಮಾಡಬೇಕು?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "ಒಂದಕ್ಕೆ 9 ಯೂರೋ ಎಂದು ನಾನು ಪ್ರಸ್ತಾಪಿಸುತ್ತೇನೆ."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "ಒಂದಕ್ಕೆ 9 ಯೂರೋ ಕೊಡುತ್ತೇನೆ, ಸರಿನಾ?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ಒಪ್ಪಂದ ಆಯಿತು!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "ಯಾವ ಕರೆನ್ಸಿಯಲ್ಲಿ ಹಣ ಕೊಡಬೇಕೆಂದಿದ್ದೀಯ?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "ನಿನ್ನ ಆರ್ಡರ್ ಕಳುಹಿಸಲಾಗಿದೆ."}]