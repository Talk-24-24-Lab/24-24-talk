[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "Kusim kachkani yapamanta rikuspayki!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "Napaykullayki, allin hamusqa! Yanapaykiman chu?"}, {"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "Ama hina kaspa, pipa sutinpi reservaqa kachkan?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Pipa sutinpi?"}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "Cuartoman ñawpaqta yaykuyta atiymanchu?"}, {"pack": "hotel", "key": "deposit", "register": "formal", "fr": "Nous demandons une caution de 100 euros, rendue au départ.", "text": "100 euro garantiata mañakuyku, ripukuptiykichis kutichipusqaykichis."}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "Codigoykita qillqayta atinki."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Qullqi chaskisqa qillqata munankichu?"}, {"pack": "hotel", "key": "double_twin", "register": "informal", "fr": "Tu préfères un grand lit ou deux lits ?", "text": "Huk hatun puñunatachu icha iskay puñunatachu munanki?"}, {"pack": "hotel", "key": "baby_cot", "register": "formal", "fr": "Un lit bébé est disponible gratuitement.", "text": "Wawapaq puñunaqa mana qullqiyuqmi kachkan."}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "Kunan cuartota pichaymanchu?"}, {"pack": "hotel", "key": "buffet", "register": "formal", "fr": "C'est un buffet : servez-vous.", "text": "Kayqa buffetmi: ama hina kaspa, kikiykichis hurqukuychis."}, {"pack": "hotel", "key": "buffet", "register": "informal", "fr": "C'est un buffet : sers-toi.", "text": "Kayqa buffetmi: kikiyki hurqukuy."}, {"pack": "hotel", "key": "room_service", "register": "formal", "fr": "Le service en chambre est disponible jusqu'à 22 heures.", "text": "Cuartoman mikhuy apaypa servicionqa 22 horakama kachkan."}, {"pack": "hotel", "key": "charge_room", "register": "formal", "fr": "Je le mets sur votre chambre ?", "text": "Cuartoykichispa cuentanman churaymanchu?"}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "Cuartoykipa cuentanman churaymanchu?"}, {"pack": "hotel", "key": "recommend_restaurant", "register": "formal", "fr": "Je peux vous conseiller un bon restaurant tout près.", "text": "Kaylla allin mikhuna wasita willaykichisman."}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "Kaylla allin mikhuna wasita willaykiman."}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "Huk hora ukhupi allichasqa kanqa."}, {"pack": "hotel", "key": "manager", "register": "formal", "fr": "Je voudrais parler au responsable.", "text": "Kamachiqwan rimayta munani."}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "Maypitaq qullqita hurquyta atiyman?"}, {"pack": "hotel", "key": "late_checkout", "register": "formal", "fr": "Est-ce que je peux partir plus tard ?", "text": "Aswan qhepata ripuyta atiymanchu?"}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "Kaypi facturayki."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "Allintachu kaypi tiyarqankichis?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Allintachu tiyarqanki?"}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Kusisqa kaspaqa, internetpi yuyayniykita saqiyta atinki."}, {"pack": "hotel", "key": "colleague_help", "register": "informal", "fr": "Tu peux m'aider à la réception ?", "text": "Recepcionpi yanapawankimanchu?"}, {"pack": "business", "key": "nice_to_meet", "register": "formal", "fr": "Enchanté de vous rencontrer.", "text": "Riqsisqayki kusikuni."}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "Utqaylla empresaykuta riqsichisqayki."}, {"pack": "business", "key": "what_company", "register": "informal", "fr": "Tu travailles dans quelle boîte ?", "text": "Ima empresapitaq llamk'anki?"}, {"pack": "business", "key": "available_tuesday", "register": "formal", "fr": "Êtes-vous disponible mardi à 10 heures ?", "text": "Atipachaw 10 horapi atiwaqchu tupanakuyta?"}, {"pack": "business", "key": "available_tuesday", "register": "informal", "fr": "Tu es dispo mardi à 10 heures ?", "text": "Atipachaw 10 horapi atinkichu?"}, {"pack": "business", "key": "video_call", "register": "formal", "fr": "Nous pouvons faire la réunion en visioconférence.", "text": "Videowan huñunakuyta ruwasunman."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Videollawan ruwasunman."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Paqarinman kuyuchisunmanchu?"}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "Qillqaykuta saqisqayki."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Hayk'atataq mañakuyta munanki?"}, {"pack": "business", "key": "volume_discount", "register": "formal", "fr": "Au-delà de 1 000 pièces, nous offrons 10 % de remise.", "text": "1 000 rakimanta aswanpaqqa, 10 % pisichiyta qoyku."}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Chaninta pisichiyta atiwaqchu?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "Sapanka rakimanta 9 eurota qoykichis."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "Sapanka rakimanta 9 eurota qoyki."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Rimanakusqañam!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "Ima qullqipitaq pagayta munanki?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "Mañakusqaykiqa ñam ripun."}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "Willakuyniykumanta yapamanta qayllaykichisman kutimuni."}, {"pack": "business", "key": "recommend_us", "register": "informal", "fr": "Tu pourrais nous recommander autour de toi ?", "text": "Riqsisqaykikunaman willawankumanchu?"}, {"pack": "business", "key": "best_regards", "register": "informal", "fr": "À bientôt !", "text": "Tupananchiskama!"}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "Qhepa p'unchawqa ch'askachaw."}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "Allinmi, sumaq llamk'ay!"}]