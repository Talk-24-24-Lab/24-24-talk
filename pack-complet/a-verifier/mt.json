[{"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "Bonġu, merħba! Nista' ngħinek?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "F'isem min?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Kemm intom persuni?"}, {"pack": "hotel", "key": "room_not_ready", "register": "formal", "fr": "Votre chambre n'est pas encore prête. Elle le sera vers 14 heures.", "text": "Il-kamra tagħkom għadha mhix lesta. Tkun lesta għall-ħabta tal-14:00."}, {"pack": "hotel", "key": "room_not_ready", "register": "informal", "fr": "Ta chambre n'est pas encore prête. Elle le sera vers 14 heures.", "text": "Il-kamra tiegħek għadha mhix lesta. Tkun lesta għall-14:00 bejn wieħed u ieħor."}, {"pack": "hotel", "key": "breakfast_hours", "register": "formal", "fr": "Le petit-déjeuner est servi de 7 heures à 10 heures 30.", "text": "Il-kolazzjon jiġi servut mis-7:00 sal-10:30."}, {"pack": "hotel", "key": "checkout_time", "register": "formal", "fr": "Le départ se fait avant 11 heures.", "text": "It-tluq irid ikun qabel il-11:00."}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "Tista' ddaħħal il-kodiċi tiegħek."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Trid riċevuta?"}, {"pack": "hotel", "key": "charge_room", "register": "formal", "fr": "Je le mets sur votre chambre ?", "text": "Inniżżlu fuq il-kont tal-kamra tagħkom, jekk jogħġbok?"}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "L-ikla t-tajba!"}, {"pack": "hotel", "key": "manager", "register": "formal", "fr": "Je voudrais parler au responsable.", "text": "Nixtieq inkellem lill-maniġer."}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Jekk int kuntent, tista' tħalli reviżjoni fuq l-internet."}, {"pack": "hotel", "key": "shift_change", "register": "informal", "fr": "Je finis à 18 heures, qui me remplace ?", "text": "Jien nispiċċa fis-18:00, min se jieħu postni?"}, {"pack": "business", "key": "nice_to_meet", "register": "formal", "fr": "Enchanté de vous rencontrer.", "text": "Għandi pjaċir nagħrafkom."}, {"pack": "business", "key": "nice_to_meet", "register": "informal", "fr": "Ravi de te rencontrer.", "text": "Pjaċir!"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "Ħa ngħidlek fil-qosor dwar il-kumpanija tagħna."}, {"pack": "business", "key": "what_company", "register": "informal", "fr": "Tu travailles dans quelle boîte ?", "text": "F'liema kumpanija taħdem?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Nistgħu nagħmluha bil-vidjo."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Nistgħu nħalluha għal għada?"}, {"pack": "business", "key": "summary_email", "register": "formal", "fr": "Je vous enverrai un compte rendu par e-mail.", "text": "Nibagħtilkom sommarju bl-email."}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Nista' nagħmlilkom dimostrazzjoni."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Kemm trid tordna?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Ftehim magħluq!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Sew, miftiehma!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "B'liema munita trid tħallas?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "L-ordni tiegħek intbagħtet."}, {"pack": "business", "key": "customs", "register": "formal", "fr": "Les frais de douane sont à la charge de l'acheteur.", "text": "Id-dazju tad-dwana jħallasha x-xerrej."}, {"pack": "business", "key": "looking_forward", "register": "informal", "fr": "Au plaisir de bosser avec toi.", "text": "Nistenna bil-ħerqa li naħdem miegħek."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Dejjem tiegħek."}]