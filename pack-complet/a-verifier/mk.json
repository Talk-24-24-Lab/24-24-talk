[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "Мило ми е што пак те гледам!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "Здраво, добредојде! Може ли да ти помогнам?"}, {"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "На чие име е резервацијата?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "Колку лица сте?"}, {"pack": "hotel", "key": "breakfast_hours", "register": "formal", "fr": "Le petit-déjeuner est servi de 7 heures à 10 heures 30.", "text": "Појадокот се служи од 7:00 до 10:30 часот."}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "Може ли да влезам во собата порано?"}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "Можеш да го внесеш твојот код."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "Сакаш ли сметка?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "Може ли сега да ја исчистам собата?"}, {"pack": "hotel", "key": "table_for", "register": "informal", "fr": "Une table pour combien ?", "text": "Маса за колку?"}, {"pack": "hotel", "key": "wifi_not_working", "register": "formal", "fr": "Le wifi ne marche pas.", "text": "Безжичниот интернет не работи."}, {"pack": "hotel", "key": "room_dirty", "register": "formal", "fr": "La chambre n'est pas propre.", "text": "Собата не е чиста."}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "Еве ја твојата фактура."}, {"pack": "hotel", "key": "leave_review", "register": "informal", "fr": "Si tu es content, tu peux laisser un avis sur internet.", "text": "Ако си задоволен, можеш да оставиш рецензија на интернет."}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "Накратко ќе ти ја претставам нашата фирма."}, {"pack": "business", "key": "speak_english", "register": "formal", "fr": "Parlez-vous anglais ?", "text": "Зборувате ли англиски?"}, {"pack": "business", "key": "speak_english", "register": "informal", "fr": "Tu parles anglais ?", "text": "Зборуваш ли англиски?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Може да го направиме преку видеоповик."}, {"pack": "business", "key": "running_late", "register": "formal", "fr": "Je suis désolé, j'aurai dix minutes de retard.", "text": "Се извинувам, ќе доцнам десет минути."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Може ли да го одложиме за утре?"}, {"pack": "business", "key": "summary_email", "register": "informal", "fr": "Je t'envoie un résumé par e-mail.", "text": "Ќе ти пратам резиме по е-пошта."}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "Што точно ти треба?"}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Колку сакаш да нарачаш?"}, {"pack": "business", "key": "need_think", "register": "formal", "fr": "J'ai besoin d'y réfléchir.", "text": "Треба да размислам."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Зделката е склучена!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Важи, договорено!"}, {"pack": "business", "key": "contract_length", "register": "formal", "fr": "Le contrat dure un an, renouvelable.", "text": "Договорот трае една година, со можност за обновување."}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "Во која валута сакаш да платиш?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "Твојата нарачка е испратена."}]