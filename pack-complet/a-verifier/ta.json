[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "உன்னை மீண்டும் பார்த்ததில் மகிழ்ச்சி!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "வணக்கம், வருக! நான் உனக்கு உதவலாமா?"}, {"pack": "hotel", "key": "have_booking", "register": "informal", "fr": "Tu as une réservation ?", "text": "நீ முன்பதிவு செய்திருக்கிறாயா?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "யார் பெயரில் இருக்கிறது?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "நீங்கள் எத்தனை பேர்?"}, {"pack": "hotel", "key": "checkout_time", "register": "formal", "fr": "Le départ se fait avant 11 heures.", "text": "காலை 11 மணிக்கு முன் அறையை காலி செய்ய வேண்டும்."}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "உன் ரகசிய எண்ணை அழுத்தலாம்."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "உனக்கு ரசீது வேண்டுமா?"}, {"pack": "hotel", "key": "baby_cot", "register": "formal", "fr": "Un lit bébé est disponible gratuitement.", "text": "குழந்தைக்கான தொட்டில் இலவசமாக கிடைக்கும்."}, {"pack": "hotel", "key": "safe", "register": "formal", "fr": "Il y a un coffre-fort dans le placard.", "text": "அலமாரியில் ஒரு பாதுகாப்புப் பெட்டகம் உள்ளது."}, {"pack": "hotel", "key": "minibar", "register": "formal", "fr": "Les boissons du minibar sont payantes.", "text": "சிறு குளிர்பெட்டியில் உள்ள பானங்களுக்கு கட்டணம் உண்டு."}, {"pack": "hotel", "key": "housekeeping_time", "register": "informal", "fr": "Tu veux le ménage à quelle heure ?", "text": "உன் அறையை எத்தனை மணிக்கு சுத்தம் செய்ய வேண்டும்?"}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "நான் இப்போது அறையை சுத்தம் செய்யலாமா?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "இப்போ அறையை சுத்தம் பண்ணட்டுமா?"}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "அருகில் ஒரு நல்ல உணவகத்தை உனக்குப் பரிந்துரைக்கலாம்."}, {"pack": "hotel", "key": "ac_broken", "register": "formal", "fr": "La climatisation ne marche pas.", "text": "குளிரூட்டி வேலை செய்யவில்லை."}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "அதிகபட்சம் ஒரு மணி நேரத்தில் சரி செய்யப்படும்."}, {"pack": "hotel", "key": "compensation", "register": "informal", "fr": "Pour nous excuser, ton petit-déjeuner est offert.", "text": "மன்னிப்பாக, உன் காலை உணவு இலவசம்."}, {"pack": "hotel", "key": "taxi", "register": "formal", "fr": "Voulez-vous que j'appelle un taxi ?", "text": "நான் உங்களுக்கு ஒரு டாக்ஸியை அழைக்கட்டுமா?"}, {"pack": "hotel", "key": "taxi", "register": "informal", "fr": "Tu veux que j'appelle un taxi ?", "text": "உனக்கு டாக்ஸி கூப்பிடட்டுமா?"}, {"pack": "hotel", "key": "how_far", "register": "formal", "fr": "C'est loin à pied ?", "text": "நடந்து போனால் தூரமா?"}, {"pack": "hotel", "key": "ten_minutes_walk", "register": "formal", "fr": "C'est à dix minutes à pied.", "text": "நடந்தால் பத்து நிமிடம் ஆகும்."}, {"pack": "hotel", "key": "here_invoice", "register": "informal", "fr": "Voici ta facture.", "text": "இதோ உன் பில்."}, {"pack": "hotel", "key": "invoice_email", "register": "informal", "fr": "Tu veux la facture par e-mail ?", "text": "பில்லை மின்னஞ்சலில் அனுப்பட்டுமா?"}, {"pack": "hotel", "key": "keep_luggage_after", "register": "formal", "fr": "Nous pouvons garder vos bagages après le départ.", "text": "அறையை காலி செய்த பிறகும் உங்கள் பைகளை நாங்கள் வைத்திருக்கலாம்."}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "உன் தங்குதல் நன்றாக இருந்ததா?"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "எங்கள் நிறுவனத்தைப் பற்றி சுருக்கமாக சொல்கிறேன்."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "இதை வீடியோ அழைப்பில் செய்யலாம்."}, {"pack": "business", "key": "summary_email", "register": "formal", "fr": "Je vous enverrai un compte rendu par e-mail.", "text": "கூட்டத்தின் சுருக்கத்தை மின்னஞ்சலில் உங்களுக்கு அனுப்புகிறேன்."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "உங்களுக்கு சரியாக என்ன தேவை?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "உனக்கு சரியாக என்ன வேண்டும்?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "நான் உங்களுக்கு ஒரு செயல்விளக்கம் காட்டலாம்."}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "எங்கள் விளக்கக் கையேட்டை உங்களிடம் விட்டுச் செல்கிறேன்."}, {"pack": "business", "key": "send_quote", "register": "formal", "fr": "Je vous envoie un devis d'ici demain.", "text": "நாளைக்குள் உங்களுக்கு விலைப்புள்ளி அனுப்புகிறேன்."}, {"pack": "business", "key": "send_quote", "register": "informal", "fr": "Je t'envoie un devis d'ici demain.", "text": "நாளைக்குள் உனக்கு விலைப்புள்ளி அனுப்புகிறேன்."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "உனக்கு எவ்வளவு ஆர்டர் செய்ய வேண்டும்?"}, {"pack": "business", "key": "too_expensive", "register": "formal", "fr": "C'est trop cher pour nous.", "text": "இது எங்களுக்கு மிகவும் விலை அதிகம்."}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "விலையில் கொஞ்சம் குறைக்க முடியுமா?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "ஒரு பொருளுக்கு 9 யூரோ என்று நான் முன்மொழிகிறேன்."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "ஒன்றுக்கு 9 யூரோ தருகிறேன், சரியா?"}, {"pack": "business", "key": "ask_manager", "register": "formal", "fr": "Je dois en parler à ma direction.", "text": "இதைப் பற்றி என் நிர்வாகத்துடன் பேச வேண்டும்."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ஒப்பந்தம் முடிந்தது!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "சரி, ஒப்புக்கொண்டோம்!"}, {"pack": "business", "key": "cancel_notice", "register": "formal", "fr": "Le préavis de résiliation est de trois mois.", "text": "ஒப்பந்தத்தை ரத்து செய்ய மூன்று மாத முன்னறிவிப்பு தேவை."}, {"pack": "business", "key": "change_clause", "register": "formal", "fr": "Nous aimerions modifier cette clause.", "text": "இந்த விதியை மாற்ற விரும்புகிறோம்."}, {"pack": "business", "key": "payment_terms", "register": "formal", "fr": "Le paiement se fait à 30 jours fin de mois.", "text": "மாத இறுதியிலிருந்து 30 நாட்களில் கட்டணம் செலுத்தப்படும்."}, {"pack": "business", "key": "deposit_30", "register": "formal", "fr": "Nous demandons un acompte de 30 % à la commande.", "text": "ஆர்டர் செய்யும்போது 30 % முன்பணம் கேட்கிறோம்."}, {"pack": "business", "key": "send_invoice", "register": "informal", "fr": "Je t'envoie la facture aujourd'hui.", "text": "இன்றைக்கே உனக்கு பில் அனுப்புகிறேன்."}, {"pack": "business", "key": "invoice_late", "register": "formal", "fr": "Cette facture n'est pas encore payée.", "text": "இந்த பில் இன்னும் செலுத்தப்படவில்லை."}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "எந்த நாணயத்தில் பணம் செலுத்த விரும்புகிறாய்?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "உன் ஆர்டர் அனுப்பப்பட்டுவிட்டது."}, {"pack": "business", "key": "tracking", "register": "formal", "fr": "Voici le numéro de suivi.", "text": "இதோ கண்காணிப்பு எண்."}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "பொருட்கள் சேதமடைந்த நிலையில் வந்தன."}, {"pack": "business", "key": "long_term", "register": "formal", "fr": "Nous voulons construire un partenariat sur le long terme.", "text": "நீண்டகால கூட்டாண்மையை உருவாக்க விரும்புகிறோம்."}, {"pack": "business", "key": "recommend_us", "register": "informal", "fr": "Tu pourrais nous recommander autour de toi ?", "text": "உனக்குத் தெரிந்தவர்களிடம் எங்களைப் பரிந்துரைக்க முடியுமா?"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "அன்புடன்."}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "கடைசி தேதி வெள்ளிக்கிழமை."}, {"pack": "business", "key": "share_file", "register": "informal", "fr": "Je te partage le fichier.", "text": "கோப்பை உன்னுடன் பகிர்கிறேன்."}]