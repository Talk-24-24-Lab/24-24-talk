[{"pack": "hotel", "key": "welcome_back", "register": "informal", "fr": "Content de te revoir !", "text": "ආයෙත් ඔයාව දකින්න ලැබීම සතුටක්!"}, {"pack": "hotel", "key": "hello_welcome", "register": "informal", "fr": "Salut, bienvenue ! Je peux t'aider ?", "text": "හායි, සාදරයෙන් පිළිගන්නවා! මම ඔයාට උදව් කරන්නද?"}, {"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "වෙන්කිරීම කාගේ නමින්ද?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "කාගේ නමින්ද?"}, {"pack": "hotel", "key": "how_many_people", "register": "formal", "fr": "Vous êtes combien de personnes ?", "text": "ඔබ කී දෙනෙක්ද?"}, {"pack": "hotel", "key": "room_not_ready", "register": "informal", "fr": "Ta chambre n'est pas encore prête. Elle le sera vers 14 heures.", "text": "ඔයාගේ කාමරේ තාම ලෑස්ති නැහැ. 14:00 විතර වෙනකොට ලෑස්ති වෙයි."}, {"pack": "hotel", "key": "enter_pin", "register": "informal", "fr": "Tu peux taper ton code.", "text": "ඔයාගේ කේතය ටයිප් කරන්න පුළුවන්."}, {"pack": "hotel", "key": "receipt", "register": "informal", "fr": "Tu veux un reçu ?", "text": "ඔයාට රිසිට් එකක් ඕනද?"}, {"pack": "hotel", "key": "do_not_disturb", "register": "informal", "fr": "Mets le panneau « Ne pas déranger » si tu veux être tranquille.", "text": "ඔයාට කරදරයක් නැතුව ඉන්න ඕන නම් \"බාධා නොකරන්න\" පුවරුව දොරේ එල්ලන්න."}, {"pack": "hotel", "key": "clean_now", "register": "formal", "fr": "Puis-je faire le ménage maintenant ?", "text": "මට දැන් කාමරය පිරිසිදු කළ හැකිද?"}, {"pack": "hotel", "key": "clean_now", "register": "informal", "fr": "Je peux faire le ménage maintenant ?", "text": "මම දැන් කාමරේ සුද්ද කරන්නද?"}, {"pack": "hotel", "key": "come_back_later", "register": "formal", "fr": "Je repasse plus tard.", "text": "මම පස්සේ ආයෙත් එන්නම්."}, {"pack": "hotel", "key": "recommend_restaurant", "register": "informal", "fr": "Je peux te conseiller un bon resto tout près.", "text": "මට ළඟපාත හොඳ කෑම කඩයක් කියන්න පුළුවන්."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "රසවත් ආහාර වේලක් වේවා!"}, {"pack": "hotel", "key": "taxi", "register": "formal", "fr": "Voulez-vous que j'appelle un taxi ?", "text": "මම ඔබට ටැක්සියක් කැඳවන්නද?"}, {"pack": "hotel", "key": "how_far", "register": "formal", "fr": "C'est loin à pied ?", "text": "පයින් යන්න දුරද?"}, {"pack": "hotel", "key": "atm", "register": "formal", "fr": "Où est-ce que je peux retirer de l'argent ?", "text": "මට මුදල් ලබාගත හැක්කේ කොහෙන්ද?"}, {"pack": "hotel", "key": "late_checkout", "register": "formal", "fr": "Est-ce que je peux partir plus tard ?", "text": "මට පසුව පිටවිය හැකිද?"}, {"pack": "hotel", "key": "colleague_help", "register": "informal", "fr": "Tu peux m'aider à la réception ?", "text": "ඔයාට පිළිගැනීමේ කවුළුවේ මට උදව් කරන්න පුළුවන්ද?"}, {"pack": "hotel", "key": "shift_change", "register": "informal", "fr": "Je finis à 18 heures, qui me remplace ?", "text": "මම 18:00ට වැඩ ඉවර කරනවා, මගේ තැනට එන්නේ කවුද?"}, {"pack": "business", "key": "introduce_company", "register": "informal", "fr": "Je te présente vite notre boîte.", "text": "මම ඔයාට අපේ සමාගම ගැන කෙටියෙන් කියන්නම්."}, {"pack": "business", "key": "what_company", "register": "informal", "fr": "Tu travailles dans quelle boîte ?", "text": "ඔයා වැඩ කරන්නේ මොන සමාගමේද?"}, {"pack": "business", "key": "available_tuesday", "register": "informal", "fr": "Tu es dispo mardi à 10 heures ?", "text": "ඔයා අඟහරුවාදා උදේ 10ට නිදහස්ද?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "අපිට ඒක වීඩියෝ කෝල් එකකින් කරන්න පුළුවන්."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "අපිට ඒක හෙටට දාන්න පුළුවන්ද?"}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "ඔබට හරියටම අවශ්‍ය මොනවාද?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "ඔයාට හරියටම ඕන මොකක්ද?"}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "අපගේ තොරතුරු පත්‍රිකාව ඔබ වෙත තබා යමි."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "අපේ පත්‍රිකාව ඔයාට දාලා යන්නම්."}, {"pack": "business", "key": "customized", "register": "informal", "fr": "On peut adapter l'offre à ta boîte.", "text": "අපිට ඔයාගේ සමාගමට ගැළපෙන විදිහට දීමනාව වෙනස් කරන්න පුළුවන්."}, {"pack": "business", "key": "send_quote", "register": "informal", "fr": "Je t'envoie un devis d'ici demain.", "text": "හෙට වෙනකොට මම ඔයාට මිල ගණන් යවන්නම්."}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "ඔයාට කීයක් ඕඩර් කරන්න ඕනද?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "ඔයාට මිලෙන් ටිකක් අඩු කරන්න පුළුවන්ද?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ගනුදෙනුව ස්ථිරයි!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "හරි, එකඟයි!"}, {"pack": "business", "key": "currency", "register": "informal", "fr": "Tu veux payer en quelle monnaie ?", "text": "ඔයා ගෙවන්න කැමති මොන මුදල් ඒකකයෙන්ද?"}, {"pack": "business", "key": "shipped", "register": "informal", "fr": "Ta commande est partie.", "text": "ඔයාගේ ඕඩර් එක යැව්වා."}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "භාණ්ඩ හානි වූ තත්ත්වයෙන් ලැබී ඇත."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "ගෞරවයෙන්."}]