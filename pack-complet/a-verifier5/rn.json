[{"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "Irezerivasiyo iri mw'izina irihe?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Ni mw'izina irihe?"}, {"pack": "hotel", "key": "buffet", "register": "informal", "fr": "C'est un buffet : sers-toi.", "text": "Ni buffet: ifatire."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Apeti nziza!"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "Mwagize ukuguma kwiza hano?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Wagize ukuguma kwiza hano?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Turashobora kubikora mu kiganiro ca videwo."}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Ndashobora kubakorera demonstrasiyo."}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "Ndashobora kugukorera demo."}, {"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "Mushobora gukora akigoro ku giciro?"}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Ushobora gukora akigoro ku giciro?"}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "Ndagushikiriza amayero 9 kuri buri kimwe."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Isoko ryemejwe!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Ni vyiza, biremewe!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Ndabaramukije mu cubahiro."}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "Bravo, akazi keza!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Imvura iriko iragwa cane."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Uriko urakina!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Ndiyumvira ko uriko urakina."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Si bibi, ku ntango…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Biracari kure yo kuba vyiza."}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Sinashaka kubababaza, nakina gusa."}]