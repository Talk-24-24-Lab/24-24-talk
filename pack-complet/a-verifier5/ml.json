[{"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "നിങ്ങൾ ഒരു നല്ല താമസം ചെലവഴിച്ചോ?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "നീ ഒരു നല്ല താമസം ചെലവഴിച്ചോ?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "നമുക്ക് ഇത് വീഡിയോയിൽ ചെയ്യാൻ കഴിയും."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ഡീൽ ഉറപ്പിച്ചു!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "നടക്കും, സമ്മതമാണ്!"}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "തുടക്കത്തിന് മോശമില്ല…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "ഇത് നല്ലതാകാൻ ഇനിയും വളരെ ദൂരമുണ്ട്."}]