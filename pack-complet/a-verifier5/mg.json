[{"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Amin'ny anarana inona?"}, {"pack": "hotel", "key": "booked_online", "register": "formal", "fr": "J'ai réservé sur internet.", "text": "Namandrika tamin'ny internet aho."}, {"pack": "hotel", "key": "fixed_soon", "register": "formal", "fr": "Ce sera réparé dans une heure au plus tard.", "text": "Ho voaamboatra ao anatin'ny adiny iray farafahatarany izany."}, {"pack": "hotel", "key": "guest_waiting", "register": "informal", "fr": "Un client attend à l'accueil.", "text": "Mpanjifa iray no miandry eo amin'ny fandraisana."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Afaka manao izany amin'ny video isika."}, {"pack": "business", "key": "agenda", "register": "formal", "fr": "Voici l'ordre du jour de la réunion.", "text": "Ity ny laharam-pandinihana amin'ny fivoriana."}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Azo ahemotra ho rahampitso ve?"}, {"pack": "business", "key": "send_quote", "register": "formal", "fr": "Je vous envoie un devis d'ici demain.", "text": "Handefa devis aminareo aho hatramin'ny rahampitso."}, {"pack": "business", "key": "send_quote", "register": "informal", "fr": "Je t'envoie un devis d'ici demain.", "text": "Handefa devis aminao aho hatramin'ny rahampitso."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Tapaka ny fifanarahana!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Mety izany, d'accord isika!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Miarahaba am-po."}]