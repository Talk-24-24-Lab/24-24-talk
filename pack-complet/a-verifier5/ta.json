[{"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ஒப்பந்தம் முடிக்கப்பட்டது!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "சரி, அது ஒப்புக்கொள்ளப்பட்டது!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "அருமை, திங்கட்கிழமை வந்துவிட்டது…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "எனக்குத் திங்கட்கிழமை பிடிக்காது."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "தொடக்கத்திற்கு மோசமில்லை…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "இது இன்னும் நன்றாக இருப்பதிலிருந்து வெகு தொலைவில் உள்ளது."}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "உங்களைப் புண்படுத்த நினைக்கவில்லை, இது வெறும் விளையாட்டுக்குத்தான்."}]