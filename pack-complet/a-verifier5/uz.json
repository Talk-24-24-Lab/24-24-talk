[{"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Bu qaysi nomga?"}, {"pack": "hotel", "key": "early_checkin", "register": "formal", "fr": "Est-ce que je peux entrer dans la chambre plus tôt ?", "text": "Men xonaga barvaqtroq kirishim mumkinmi?"}, {"pack": "hotel", "key": "how_far", "register": "formal", "fr": "C'est loin à pied ?", "text": "Bu piyoda uzoqmi?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Yaxshi qolish o'tkazdingmi?"}, {"pack": "business", "key": "postpone", "register": "informal", "fr": "On peut décaler à demain ?", "text": "Ertaga surib qo'ysak bo'ladimi?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Kelishuv tuzildi!"}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "Bu juda oson!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "Bu juda oson."}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Menimcha, sen hazillashyapsan."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Suhbatni boshlash uchun sizga qahva olib beraymi?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Albatta, hazillashdim!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Zo'r, bugun dushanba…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Men dushanbani yoqtirmayman."}]