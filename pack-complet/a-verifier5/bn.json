[{"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "চলবে, ঠিক আছে!"}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "এটার দাম আকাশছোঁয়া।"}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "এটা খুব দামি।"}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "তুমি মজা করছ!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "আমার মনে হয় তুমি মজা করছ।"}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "আলাপ শুরু করতে, আমি কি আপনাকে এক কাপ কফি খাওয়াতে পারি?"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "আপনাকে আঘাত করার ইচ্ছা ছিল না, এটা নিছক মজা ছিল।"}]