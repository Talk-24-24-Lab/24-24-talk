[{"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Ọ bụ n'aha gịnị?"}, {"pack": "hotel", "key": "booked_online", "register": "formal", "fr": "J'ai réservé sur internet.", "text": "Edebere m na ịntanetị."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Ezi agụụ!"}, {"pack": "business", "key": "my_role", "register": "formal", "fr": "Je suis responsable des ventes.", "text": "Abụ m onye isi ngalaba ire ahịa."}, {"pack": "business", "key": "need", "register": "formal", "fr": "Quel est votre besoin exactement ?", "text": "Gịnị bụ mkpa unu kpọmkwem?"}, {"pack": "business", "key": "need", "register": "informal", "fr": "Tu as besoin de quoi exactement ?", "text": "Gịnị bụ mkpa gị kpọmkwem?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "Ana m atụrụ unu aro euro 9 maka otu."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Ahịa ekwekọrịtala!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Ọ na-arụ ọrụ, ọ dị mma!"}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "Ngwa ahịa bịarutere n'ụzọ mebiri emebi."}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Mmiri na-ezo nke ukwuu."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Ị na-egwu egwu!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Echere m na ị na-egwu egwu."}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Ana m egwu egwu, n'ezie!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pou