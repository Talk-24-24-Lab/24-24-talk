[{"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "શું આપનો અહીંનો નિવાસ સારો રહ્યો?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "તારો અહીંનો નિવાસ સારો રહ્યો?"}, {"pack": "business", "key": "brochure", "register": "formal", "fr": "Je vous laisse notre documentation.", "text": "હું આપને અમારું દસ્તાવેજીકરણ છોડી જાઉં છું."}, {"pack": "business", "key": "brochure", "register": "informal", "fr": "Je te laisse notre doc.", "text": "હું તને અમારું દસ્તાવેજીકરણ છોડી જાઉં છું."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "ડીલ પાક્કી!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "ચાલશે, મંજૂર છે!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "ખૂબ સૌહાર્દપૂર્વક."}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "તમને દુઃખ પહોંચાડવાનો ઇરાદો નહોતો, આ ફક્ત મજાક હતી."}]