[{"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Mba'e térape kóva?"}, {"pack": "hotel", "key": "baby_cot", "register": "formal", "fr": "Un lit bébé est disponible gratuitement.", "text": "Peteĩ mitã'i tupa oĩ reiete."}, {"pack": "hotel", "key": "enjoy_meal", "register": "formal", "fr": "Bon appétit !", "text": "Pekaru porã!"}, {"pack": "hotel", "key": "ten_minutes_walk", "register": "formal", "fr": "C'est à dix minutes à pied.", "text": "Oĩ pa minuto mombyry ojeguatávo."}, {"pack": "hotel", "key": "guest_waiting", "register": "informal", "fr": "Un client attend à l'accueil.", "text": "Peteĩ cliente oha'arõ hína recepción-pe."}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Ikatu jajapo kóva videollamada rupive."}, {"pack": "business", "key": "agenda", "register": "formal", "fr": "Voici l'ordre du jour de la réunion.", "text": "Ko'ápe oĩ ñembyaty orden del día."}, {"pack": "business", "key": "our_product", "register": "informal", "fr": "Notre produit fait gagner du temps à ton équipe.", "text": "Ore producto ogana aravo nde equipo-pe g̃uarã."}, {"pack": "business", "key": "quantity", "register": "formal", "fr": "Quelle quantité souhaitez-vous commander ?", "text": "Mboy cantidad-pa pepedise?"}, {"pack": "business", "key": "quantity", "register": "informal", "fr": "Tu veux commander combien ?", "text": "Mboýpa repedise?"}, {"pack": "business", "key": "vat", "register": "formal", "fr": "Les prix sont-ils hors taxes ou toutes taxes comprises ?", "text": "Ko'ã precio-kuéra impuesto'ỹre piko térã impuesto reheve?"}, {"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "Ikatúpa pejapo peteĩ esfuerzo precio rehe?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Acuerdo oñemohu'ãma!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Iporã, oĩma acuerdo!"}, {"pack": "business", "key": "long_term", "register": "formal", "fr": "Nous voulons construire un partenariat sur le long terme.", "text": "Roipota romopu'ã peteĩ sociedad are g̃uarã."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Maitei cordial porã."}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "Fecha límite ha'e viernes."}, {"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "Ama hatã ho'a!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Ama hatãiterei ho'a."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Reñembosaraihína!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Aimo'ã reñembosaraihína."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Ñañepyrũ hag̃ua ñañomongeta, ikatúpa ame'ẽ peẽme peteĩ kafe?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Añembosarai ha'eño, katuete!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Iporãiterei, ko'ãga arakõi…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Nachegustái arakõi."}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Ndaipotái pomoñembyasy, ñembosarái mante kuri."}]