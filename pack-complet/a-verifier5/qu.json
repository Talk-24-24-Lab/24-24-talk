[{"pack": "hotel", "key": "double_twin", "register": "informal", "fr": "Tu préfères un grand lit ou deux lits ?", "text": "Huk hatun puñunatachu icha iskay puñunakunatachu aswan munanki?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "formal", "fr": "Avez-vous passé un bon séjour ?", "text": "Allin tiyakuytachu pasarqankichis?"}, {"pack": "hotel", "key": "enjoyed_stay", "register": "informal", "fr": "Tu as passé un bon séjour ?", "text": "Allin tiyakuytachu pasarqanki?"}, {"pack": "business", "key": "available_tuesday", "register": "formal", "fr": "Êtes-vous disponible mardi à 10 heures ?", "text": "Martes p'unchaw 10 horapi disponiblechu kanki?"}, {"pack": "business", "key": "counter_offer", "register": "formal", "fr": "Je vous propose 9 euros l'unité.", "text": "9 eurota sapa unidadpaq propuniykichis."}, {"pack": "business", "key": "counter_offer", "register": "informal", "fr": "Je te propose 9 euros l'unité.", "text": "9 eurota sapa unidadpaq propuniyki."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Rimanakuy tukusqañam!"}, {"pack": "business", "key": "recommend_us", "register": "informal", "fr": "Tu pourrais nous recommander autour de toi ?", "text": "Riqsisqaykikunaman ñuqaykuta recomendawankimanchu?"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Sinchitam paramushan."}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Asikuspa rimashanki nispa yuyani."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Rimanakuyta qallarinapaq, huk kafeta invitaykiman?"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Sumaqmi, kunan lunes…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Mana lunesta munanichu."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Mana millaychu, qallarinapaq…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Manaraq allinchu."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Ancha asichiwan!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Mana phiñachiyta munarqanichu, asikuspallam karqan."}]