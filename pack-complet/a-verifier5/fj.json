[{"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "Na buking e tu e na yaca cava?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "E na yaca cava?"}, {"pack": "business", "key": "can_do_better", "register": "formal", "fr": "Pouvez-vous faire un effort sur le prix ?", "text": "Dou rawa ni cakava e dua na sasaga me baleta na isau?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Sa vakaotio na veivoli!"}, {"pack": "business", "key": "damaged", "register": "formal", "fr": "La marchandise est arrivée abîmée.", "text": "Na iyaya ni veivoli e yaco mai ni sa vakacacani."}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Vakarokoroko levu."}, {"pack": "business", "key": "good_job", "register": "informal", "fr": "Bravo, beau travail !", "text": "Vinaka sara, cakacaka totoka!"}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "E rawarawa sara!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "E rawarawa sara."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Me tekivu kina na noda veitalanoa, au rawa ni volia vei kemuni e dua na kofi?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Au veiwali tiko ga, io!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Vinaka sara, sa Moniti tale…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Au sega ni taleitaka na Moniti."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "E sega ni ca, me ivakatekivu…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "E se yawa sara mai na vinaka."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Au a dredre vakalevu!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Au sega ni nakita meu vakararawataki kemuni, e veiwali ga."}]