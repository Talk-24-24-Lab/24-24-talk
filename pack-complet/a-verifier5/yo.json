[{"pack": "hotel", "key": "booking_name", "register": "formal", "fr": "À quel nom est la réservation ?", "text": "Orúkọ wo ni ìfiṣura náà wà?"}, {"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Orúkọ wo ni?"}, {"pack": "business", "key": "demo", "register": "formal", "fr": "Je peux vous faire une démonstration.", "text": "Mo lè ṣe àṣefihàn fún yín."}, {"pack": "business", "key": "demo", "register": "informal", "fr": "Je peux te faire une démo.", "text": "Mo lè ṣe àṣefihàn kan fún ọ."}, {"pack": "business", "key": "send_quote", "register": "informal", "fr": "Je t'envoie un devis d'ici demain.", "text": "Mo ń fi ìdíyelé kan ránṣẹ́ sí ọ títí di ọ̀la."}, {"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Ṣé o lè ṣe ìsapá lórí iye owó náà?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "A ti parí àdéhùn ọjà!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Pẹ̀lú ìkíni tọkàntọkàn."}, {"pack": "business", "key": "deadline", "register": "informal", "fr": "La date limite est vendredi.", "text": "Àkókò ìparí ni Ọjọ́ Ẹtì."}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Òjò ń rọ̀ gan-an."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "Ó wọ́n gan-an ni."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "Ó wọ́n gan-an."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Láti bẹ̀rẹ̀ ọ̀rọ̀, ṣé mo lè fún yín ní kọfí?"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Ó dára o, ọjọ́ Ajé ni…"}, {"pack": "humor", "key": "monday_irony", "register": "n