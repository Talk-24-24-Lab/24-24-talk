[{"pack": "hotel", "key": "booking_name", "register": "informal", "fr": "C'est à quel nom ?", "text": "Maqaa kamiin?"}, {"pack": "hotel", "key": "charge_room", "register": "informal", "fr": "Je le mets sur ta chambre ?", "text": "Kutaa kee irratti nan galchaa?"}, {"pack": "business", "key": "video_call", "register": "informal", "fr": "On peut faire ça en visio.", "text": "Kana viidiyoo konfaransiin gochuu ni danda'ama."}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Waliigalteen xumurameera!"}, {"pack": "business", "key": "sign_here", "register": "informal", "fr": "Tu peux signer ici ?", "text": "Asitti mallattoo kaa'uu ni dandeessaa?"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Nagaa onnee irraa."}, {"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "Roobni baay'ee jabaatee roobaa jira!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Roobni baay'ee cimaa roobaa jira."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "Baay'ee salphaa dha!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "Baay'ee salphaa dha."}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Akka qoostu natti fakkaata."}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Baay'ee gaarii, har'a Wiixata…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Wiixata hin jaalladhu."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Baay'ee na kofalchiise!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans voulo