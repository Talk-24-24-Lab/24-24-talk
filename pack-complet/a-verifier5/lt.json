[{"pack": "business", "key": "can_do_better", "register": "informal", "fr": "Tu peux faire un effort sur le prix ?", "text": "Ar gali pasistengti dėl kainos?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Sutartis sudaryta!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Tinka, sutarta!"}, {"pack": "business", "key": "follow_up", "register": "formal", "fr": "Je reviens vers vous au sujet de notre proposition.", "text": "Grįžtu pas Jus dėl mūsų pasiūlymo."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "Tai vieni niekai!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "Tai labai lengva."}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Puiku, pirmadienis…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Nemėgstu pirmadienių."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Neblogai, pradžiai…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Tai dar toli gražu ne gerai."}]