[{"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "Nahimo na ang kasabutan!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "Sige, okay na!"}, {"pack": "business", "key": "best_regards", "register": "formal", "fr": "Bien cordialement.", "text": "Uban ang kinasingkasing nga pagtimbaya."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Nagbiaybiay ka lang!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Sa akong hunahuna nagbiaybiay ka lang."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Aron magsugod ang istorya, puwede ba ko mopalit og kape para ninyo?"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Wala koy tuyo nga masakitan mo, biaybiay lang to."}]