[{"pack": "hotel", "key": "shift_change", "register": "informal", "fr": "Je finis à 18 heures, qui me remplace ?", "text": "म 18 बजे काम सकाउँछु, मलाई कसले प्रतिस्थापन गर्छ?"}, {"pack": "business", "key": "deal", "register": "formal", "fr": "Marché conclu !", "text": "सम्झौता सम्पन्न भयो!"}, {"pack": "business", "key": "deal", "register": "informal", "fr": "Ça marche, c'est d'accord !", "text": "ठिक छ, यो सहमत भयो!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "धेरै ठूलो पानी परिरहेको छ।"}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "कुराकानी सुरु गर्न, म तपाईंलाई एक कप कफी खुवाऊँ?"}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "सुरुवातको लागि नराम्रो छैन…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "यो अझै राम्रो हुनबाट धेरै टाढा छ।"}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "यसले मलाई धेरै हँसायो!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "तपाईंलाई चोट पुर्‍याउने उद्देश्य थिएन, यो केवल ठट्टा थियो।"}]