[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "ধাৰাসাৰ বৰষুণ দিছে!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "বহুত জোৰেৰে বৰষুণ দিছে।"}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "এইটো একেবাৰে সহজ!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "এইটো বহুত সহজ।"}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "এইটো বহুত দামী।"}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "এইটো বহুত দামী।"}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "তুমি ধেমালি কৰিছা!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "মোৰ ভাব হয় তুমি ধেমালি কৰিছা।"}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "কথা আৰম্ভ কৰিবলৈ, মই আপোনাক এটা কফি খুৱাব পাৰোনে?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "নিশ্চয়, মই ধেমালি কৰিছিলোঁ!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "বাঃ, আজি সোমবাৰ…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "মই সোমবাৰ ভাল নাপাওঁ।"}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "আৰম্ভণিৰ বাবে বেয়া নহয়…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "এইটো এতিয়াও ভাল হোৱাৰ পৰা বহু দূৰত।"}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "এইটোৱে মোক বহুত হহুৱালে!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "আপোনাক আঘাত দিয়াৰ উদ্দেশ্য নাছিল, ই কেৱল ধেমালি আছিল।"}]