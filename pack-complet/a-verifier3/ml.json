[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "പെരുമഴ പെയ്യുന്നു!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "വളരെ ശക്തമായി മഴ പെയ്യുന്നു."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "ഇത് വളരെ എളുപ്പമാണ്!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "ഇത് വളരെ എളുപ്പമാണ്."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "ഇതിന് തീവിലയാണ്."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "ഇത് വളരെ വിലയേറിയതാണ്."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "നീ തമാശ പറയുകയാണ്!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "നീ തമാശ പറയുകയാണെന്ന് ഞാൻ കരുതുന്നു."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "സംസാരം തുടങ്ങാൻ, ഞാൻ നിങ്ങൾക്ക് ഒരു കാപ്പി വാങ്ങിത്തരട്ടെ?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "തീർച്ചയായും, ഞാൻ തമാശ പറഞ്ഞതാണ്!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "കൊള്ളാം, ഇന്ന് തിങ്കളാഴ്ച…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "എനിക്ക് തിങ്കളാഴ്ച ഇഷ്ടമല്ല."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "തുടക്കത്തിന് മോശമില്ല…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "ഇത് നല്ലതാകാൻ ഇനിയും വളരെ ദൂരമുണ്ട്."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "ഇത് എന്നെ നന്നായി ചിരിപ്പിച്ചു!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "നിങ്ങളെ വേദനിപ്പിക്കാൻ ഉദ്ദേശിച്ചില്ല, അത് വെറും തമാശയായിരുന്നു."}]