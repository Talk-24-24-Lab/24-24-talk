[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "மழை கொட்டுகிறது!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "மிகவும் பலமாக மழை பெய்கிறது."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "இது ரொம்ப சுலபம்!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "இது மிகவும் எளிது."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "இது ரொம்ப விலை அதிகம்."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "இது மிகவும் விலை அதிகம்."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "நீ கிண்டல் பண்றே!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "நீ விளையாட்டாகச் சொல்கிறாய் என்று நினைக்கிறேன்."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "பேச்சைத் தொடங்க, உங்களுக்கு ஒரு காபி வாங்கித் தரட்டுமா?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "சும்மா விளையாட்டுக்குச் சொன்னேன், நிச்சயமாக!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "அருமை, திங்கட்கிழமை வந்துவிட்டது…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "எனக்குத் திங்கட்கிழமை பிடிக்காது."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "தொடக்கத்திற்கு மோசமில்லை…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "இது இன்னும் நன்றாக இருப்பதிலிருந்து வெகு தொலைவில் உள்ளது."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "இது என்னை நன்றாகச் சிரிக்க வைத்தது!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "உங்களைப் புண்படுத்த நினைக்கவில்லை, இது வெறும் விளையாட்டுக்குத்தான்."}]