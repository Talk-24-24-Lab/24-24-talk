[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "ಜೋರಾಗಿ ಮಳೆ ಸುರಿಯುತ್ತಿದೆ!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "ತುಂಬಾ ಜೋರಾಗಿ ಮಳೆ ಬರುತ್ತಿದೆ."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "ಇದು ತುಂಬಾ ಸುಲಭ!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "ಇದು ತುಂಬಾ ಸುಲಭ."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "ಇದು ತುಂಬಾ ದುಬಾರಿ."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "ಇದು ತುಂಬಾ ದುಬಾರಿ."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "ನೀನು ತಮಾಷೆ ಮಾಡುತ್ತಿದ್ದೀಯ!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "ನೀನು ತಮಾಷೆ ಮಾಡುತ್ತಿದ್ದೀಯ ಎಂದು ನನಗೆ ಅನಿಸುತ್ತದೆ."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "ಮಾತು ಶುರು ಮಾಡಲು, ನಿಮಗೆ ಒಂದು ಕಾಫಿ ಕೊಡಿಸಲೇ?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "ತಮಾಷೆಗೆ ಹೇಳಿದೆ, ಖಂಡಿತ!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "ಅದ್ಭುತ, ಇವತ್ತು ಸೋಮವಾರ…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "ನನಗೆ ಸೋಮವಾರ ಇಷ್ಟವಿಲ್ಲ."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "ಆರಂಭಕ್ಕೆ ಕೆಟ್ಟದಾಗಿಲ್ಲ…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "ಇದು ಇನ್ನೂ ಚೆನ್ನಾಗಿರುವುದರಿಂದ ತುಂಬಾ ದೂರವಿದೆ."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "ಇದು ನನ್ನನ್ನು ತುಂಬಾ ನಗಿಸಿತು!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "ನಿಮಗೆ ನೋವು ಮಾಡುವ ಉದ್ದೇಶವಿರಲಿಲ್ಲ, ಅದು ಕೇವಲ ತಮಾಷೆ."}]