[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "मुसलधारे पानी परिरहेको छ!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "धेरै ठूलो पानी परिरहेको छ।"}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "यो त एकदमै सजिलो छ!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "यो धेरै सजिलो छ।"}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "यो धेरै महँगो छ।"}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "यो धेरै महँगो छ।"}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "तिमी ठट्टा गर्दैछौ!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "मलाई लाग्छ तिमी ठट्टा गर्दैछौ।"}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "कुराकानी सुरु गर्न, म तपाईंलाई एक कप कफी खुवाऊँ?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "पक्कै पनि, म ठट्टा गर्दै थिएँ!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "वाह, आज सोमबार…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "मलाई सोमबार मन पर्दैन।"}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "सुरुवातको लागि नराम्रो छैन…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "यो अझै राम्रो हुनबाट धेरै टाढा छ।"}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m