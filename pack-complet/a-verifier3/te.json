[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "కుండపోత వర్షం పడుతోంది!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "చాలా భారీగా వర్షం పడుతోంది."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "ఇది చాలా సులభం!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "ఇది చాలా సులభం."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "ఇది చాలా ఖరీదు."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "ఇది చాలా ఖరీదైనది."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "నువ్వు జోక్ చేస్తున్నావు!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "నువ్వు సరదాగా అంటున్నావని నేను అనుకుంటున్నాను."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "మాటలు మొదలుపెట్టడానికి, మీకు ఒక కాఫీ ఇప్పించనా?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "సరదాకి అన్నాను, ఖచ్చితంగా!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "అద్భుతం, ఈ రోజు సోమవారం…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "నాకు సోమవారం ఇష్టం లేదు."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "మొదటిసారికి పర్వాలేదు…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "ఇది ఇంకా బాగుండటానికి చాలా దూరంలో ఉంది."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "ఇది నన్ను బాగా నవ్వించింది!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "మిమ్మల్ని బాధపెట్టాలని కాదు, ఇది కేవలం సరదాకే."}]