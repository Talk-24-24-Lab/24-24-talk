[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "ብዙሕ ዝናብ ይዘንብ ኣሎ!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "ኣዝዩ ብርቱዕ ዝናብ ይዘንብ ኣሎ።"}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "ኣዝዩ ቀሊል እዩ!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "ኣዝዩ ቀሊል እዩ።"}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "ኣዝዩ ክቡር እዩ።"}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "ኣዝዩ ክቡር እዩ።"}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "ትጻወት ኣለኻ!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "ትጻወት ከም ዘለኻ ይመስለኒ።"}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "ዘረባ ንምጅማር፡ ቡን ክዕድመኩም ዶ?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "ዋዛ እየ፡ ብርግጽ!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "ጽቡቕ፡ ሰኑይ እዩ…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "ሰኑይ ኣይፈቱን እየ።"}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "ንመጀመርታ ሕማቕ ኣይኮነን…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "ገና ጽቡቕ ካብ ምዃን ርሑቕ እዩ።"}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "ኣዝዩ ኣስሓቐኒ!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "ከቐይመኩም ኢለ ኣይኮንኩን፡ ዋዛ እዩ ነይሩ።"}]