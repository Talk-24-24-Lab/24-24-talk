[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "Está a chover a potes!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Está a chover muito."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "Isso é canja!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "É muito fácil."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "Custa os olhos da cara."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "É muito caro."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Estás a gozar comigo!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Acho que estás a brincar."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Para quebrar o gelo, posso oferecer-lhe um café?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Estou a brincar, claro!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Que maravilha, é segunda-feira…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Não gosto das segundas-feiras."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Nada mau, para começo…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Ainda está longe de estar bom."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Isso fez-me rir muito!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Sem querer ofendê-lo, era só a brincar."}]