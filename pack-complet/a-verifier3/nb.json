[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "Det høljregner!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Det regner veldig kraftig."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "Det er lett som en plett!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "Det er veldig lett."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "Det koster skjorta."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "Det er veldig dyrt."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Du tuller med meg!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Jeg tror du tuller."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "For å bryte isen, kan jeg spandere en kaffe på Dem?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Jeg tuller, selvfølgelig!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Herlig, det er mandag…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Jeg liker ikke mandager."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Ikke dårlig, til å være en start…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Det er fortsatt langt fra bra."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Det fikk meg virkelig til å le!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Uten å ville fornærme Dem, det var bare på tull."}]