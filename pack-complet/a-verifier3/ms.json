[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "Hujan lebat betul!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Hujan turun dengan sangat lebat."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "Senang sangat!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "Ia sangat mudah."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "Mahal gila."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "Ia sangat mahal."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Awak bergurau, kan!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Saya rasa awak bergurau."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Untuk memecahkan suasana, boleh saya belanja anda kopi?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Saya bergurau saja, tentulah!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Hebat, hari Isnin lagi…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Saya tidak suka hari Isnin."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Boleh tahan, untuk permulaan…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Ia masih jauh daripada bagus."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Itu buat saya ketawa betul!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Bukan niat saya untuk menyinggung perasaan anda, itu cuma gurauan."}]