[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "ຝົນຕົກໜັກຫຼາຍ!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "ຝົນຕົກໜັກຫຼາຍ."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "ງ່າຍຫຼາຍ!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "ມັນງ່າຍຫຼາຍ."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "ແພງຫຼາຍ."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "ມັນແພງຫຼາຍ."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "ເຈົ້າເວົ້າຫຼິ້ນບໍ່!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "ຂ້ອຍຄິດວ່າເຈົ້າເວົ້າຫຼິ້ນ."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "ເພື່ອເລີ່ມລົມກັນ, ຂ້ອຍຂໍລ້ຽງກາເຟທ່ານຈັກຈອກໄດ້ບໍ່?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "ແນ່ນອນ, ຂ້ອຍເວົ້າຫຼິ້ນ!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "ດີຫຼາຍ, ວັນຈັນອີກແລ້ວ…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "ຂ້ອຍບໍ່ມັກວັນຈັນ."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "ບໍ່ຮ້າຍ, ສຳລັບການເລີ່ມຕົ້ນ…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "ມັນຍັງຫ່າງໄກຈາກຄວາມດີ."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "ມັນເຮັດໃຫ້ຂ້ອຍຫົວຫຼາຍ!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "ບໍ່ໄດ້ຕັ້ງໃຈເຮັດໃຫ້ທ່ານບໍ່ພໍໃຈ, ມັນແມ່ນເວົ້າຫຼິ້ນເທົ່ານັ້ນ."}]