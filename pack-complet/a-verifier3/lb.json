[{"pack": "humor", "key": "raining_hard", "register": "informal", "fr": "Il pleut des cordes !", "text": "Et reent wéi aus Eemeren!"}, {"pack": "humor", "key": "raining_hard", "register": "neutral_meaning", "fr": "Il pleut très fort.", "text": "Et reent ganz staark."}, {"pack": "humor", "key": "piece_of_cake", "register": "informal", "fr": "C'est du gâteau !", "text": "Dat ass e Kannerspill!"}, {"pack": "humor", "key": "piece_of_cake", "register": "neutral_meaning", "fr": "C'est très facile.", "text": "Dat ass ganz einfach."}, {"pack": "humor", "key": "cost_arm", "register": "informal", "fr": "Ça coûte les yeux de la tête.", "text": "Dat kascht e Verméigen."}, {"pack": "humor", "key": "cost_arm", "register": "neutral_meaning", "fr": "C'est très cher.", "text": "Dat ass ganz deier."}, {"pack": "humor", "key": "pull_leg", "register": "informal", "fr": "Tu me fais marcher !", "text": "Du hëls mech op den Aarm!"}, {"pack": "humor", "key": "pull_leg", "register": "neutral_meaning", "fr": "Je pense que tu plaisantes.", "text": "Ech mengen, du mëss e Witz."}, {"pack": "humor", "key": "break_ice", "register": "neutral", "fr": "Pour briser la glace, je vous offre un café ?", "text": "Fir d'Äis ze briechen, kann ech Iech e Kaffi offréieren?"}, {"pack": "humor", "key": "just_kidding", "register": "informal", "fr": "Je plaisante, bien sûr !", "text": "Ech maachen nëmme Spaass, natierlech!"}, {"pack": "humor", "key": "monday_irony", "register": "ironic", "fr": "Génial, on est lundi…", "text": "Super, et ass Méindeg…"}, {"pack": "humor", "key": "monday_irony", "register": "neutral_meaning", "fr": "Je n'aime pas les lundis.", "text": "Ech hu Méindeg net gär."}, {"pack": "humor", "key": "not_bad_irony", "register": "ironic", "fr": "Pas mal, pour un début…", "text": "Net schlecht, fir den Ufank…"}, {"pack": "humor", "key": "not_bad_irony", "register": "neutral_meaning", "fr": "C'est encore loin d'être bon.", "text": "Et ass nach wäit ewech vu gutt."}, {"pack": "humor", "key": "laugh", "register": "informal", "fr": "Ça m'a bien fait rire !", "text": "Dat huet mech gutt laache gemaach!"}, {"pack": "humor", "key": "no_offense", "register": "neutral", "fr": "Sans vouloir vous offenser, c'était pour rire.", "text": "Ech wollt Iech net beleidegen, et war nëmme fir ze laachen."}]